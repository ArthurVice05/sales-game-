 min-width: 180px;\r\n  max-width: 100%;\r\n  box-sizing: border-box;\r\n}\r\n\r\n@media (max-width: 760px){\r\n  .isCards{\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n}\r\n\r\n@media (max-width: 560px){\r\n  .isCard{ padding: 14px; }\r\n  .isTitle{ padding-right: 40px; } /* não passa sob o botão ✕ */\r\n  .isSaldoRow{ flex-wrap: wrap; }\r\n  /* empilha: input em largura total, atalhos abaixo, total abaixo */\r\n  .isInputRow{ grid-template-columns: minmax(0, 1fr); }\r\n  .isInput{ width: 100%; }\r\n  .isQuickBtns{\r\n    display: grid;\r\n    grid-template-columns: repeat(4, minmax(0, 1fr));\r\n    gap: 8px;\r\n    width: 100%;\r\n  }\r\n  .isQuickBtn{ min-width: 0; width: 100%; }\r\n  .isTotalBox{ width: 100%; }\r\n  .isCards{ grid-template-columns: minmax(0, 1fr); }\r\n  .isBigBtn{ min-width: 0; width: 100%; }\r\n}\r\n\r\n/* ====== Modal \"Vendedores Comuns\": card e tabela de certificações ====== */\r\n\r\n.vcWrap{\r\n  position: fixed;\r\n  inset: 0;\r\n  background: rgba(0,0,0,.55);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  z-index: 1000;\r\n  padding: 12px;\r\n  box-sizing: border-box;\r\n  overflow-y: auto;\r\n  overflow-x: hidden;\r\n}\r\n\r\n/* border-box: padding + borda contam DENTRO da largura calculada */\r\n.vcCard{\r\n  box-sizing: border-box;\r\n  width: min(880px, calc(100vw - 24px));\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  max-height: 92vh;\r\n  max-height: 92dvh;\r\n  overflow-y: auto;\r\n  overflow-x: hidden;\r\n  background: #1b1f2a;\r\n  color: #e9ecf1;\r\n  border-radius: 16px;\r\n  padding: 20px 20px 16px;\r\n  box-shadow: 0 10px 40px rgba(0,0,0,.4);\r\n  border: 1px solid rgba(255,255,255,.12);\r\n  position: relative;\r\n}\r\n\r\n.vcTitle{\r\n  margin: 6px 0 12px;\r\n  font-weight: 800;\r\n  line-height: 1.3;\r\n  min-width: 0;\r\n  overflow-wrap: break-word;\r\n}\r\n\r\n.vcInfoBox{\r\n  width: 100%;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* desktop: mesma aparência da tabela inline anterior (2fr 1fr 1fr 1fr) */\r\n.vcTable{\r\n  border: 1px solid rgba(255,255,255,.12);\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n  margin-top: 8px;\r\n  width: 100%;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  box-sizing: border-box;\r\n}\r\n.vcTrHead{\r\n  display: grid;\r\n  grid-template-columns: 2fr 1fr 1fr 1fr;\r\n  background: #121621;\r\n}\r\n.vcTh{\r\n  padding: 10px 12px;\r\n  font-weight: 800;\r\n  border-left: 1px solid rgba(255,255,255,.06);\r\n}\r\n.vcTr{\r\n  display: grid;\r\n  grid-template-columns: 2fr 1fr 1fr 1fr;\r\n  background: #0f1320;\r\n}\r\n.vcTd{\r\n  padding: 10px 12px;\r\n  border-top: 1px solid rgba(255,255,255,.06);\r\n  border-left: 1px solid rgba(255,255,255,.06);\r\n  min-width: 0;\r\n  box-sizing: border-box;\r\n}\r\n\r\n@media (max-width: 560px){\r\n  .vcCard{ padding: 14px; }\r\n  .vcTitle{ padding-right: 40px; } /* não passa sob o botão ✕ */\r\n\r\n  /* cabeçalho some visualmente mas continua disponível para leitores de tela */\r\n  .vcTrHead{\r\n    position: absolute;\r\n    width: 1px;\r\n    height: 1px;\r\n    padding: 0;\r\n    margin: -1px;\r\n    overflow: hidden;\r\n    clip: rect(0 0 0 0);\r\n    white-space: nowrap;\r\n    border: 0;\r\n  }\r\n\r\n  /* cada linha da tabela vira um card vertical */\r\n  .vcTable{\r\n    border: none;\r\n    border-radius: 0;\r\n    overflow: visible;\r\n    display: grid;\r\n    gap: 8px;\r\n  }\r\n  .vcTr{\r\n    grid-template-columns: minmax(0, 1fr);\r\n    border: 1px solid rgba(255,255,255,.12);\r\n    border-radius: 10px;\r\n    padding: 10px 12px;\r\n  }\r\n  /* célula: rótulo (via data-label) à esquerda, valor à direita */\r\n  .vcTd{\r\n    display: grid;\r\n    grid-template-columns: minmax(110px, 1fr) minmax(0, 1fr);\r\n    gap: 8px;\r\n    align-items: baseline;\r\n    padding: 3px 0;\r\n    border: none;\r\n    overflow-wrap: break-word;\r\n  }\r\n  .vcTd::before{\r\n    content: attr(data-label);\r\n    font-weight: 700;\r\n    opacity: .85;\r\n  }\r\n  /* 1ª célula (Certificação) vira o título do card, em largura total */\r\n  .vcTd.vcTdName{\r\n    display: block;\r\n    font-weight: 800;\r\n    padding: 0 0 6px;\r\n    margin-bottom: 4px;\r\n    border-bottom: 1px solid rgba(255,255,255,.08);\r\n  }\r\n  .vcTd.vcTdName::before{\r\n    content: none;\r\n  }\r\n}\r\n\r\n/* ====== Modal \"Field Sales\": card centralizado e tabela de certificações ====== */\r\n\r\n.fsWrap{\r\n  position: fixed;\r\n  inset: 0;\r\n  background: rgba(0,0,0,.55);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  z-index: 1000;\r\n  padding: 12px;\r\n  box-sizing: border-box;\r\n  overflow-y: auto;\r\n  overflow-x: hidden;\r\n}\r\n\r\n/* border-box: padding + borda contam DENTRO da largura calculada */\r\n.fsCard{\r\n  box-sizing: border-box;\r\n  width: min(880px, calc(100vw - 24px));\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  margin-inline: auto;\r\n  max-height: 92vh;\r\n  max-height: 92dvh;\r\n  overflow-y: auto;\r\n  overflow-x: hidden;\r\n  background: #1b1f2a;\r\n  color: #e9ecf1;\r\n  border-radius: 16px;\r\n  padding: 20px 20px 16px;\r\n  box-shadow: 0 10px 40px rgba(0,0,0,.4);\r\n  border: 1px solid rgba(255,255,255,.12);\r\n  position: relative;\r\n}\r\n\r\n.fsTitle{\r\n  margin: 6px 0 12px;\r\n  font-weight: 800;\r\n  line-height: 1.3;\r\n  min-width: 0;\r\n  overflow-wrap: break-word;\r\n}\r\n\r\n.fsInfoBox{\r\n  width: 100%;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  box-sizing: border-box;\r\n}\r\n.fsInfoTitle{\r\n  font-weight: 800;\r\n  margin-bottom: 6px;\r\n  min-width: 0;\r\n  overflow-wrap: break-word;\r\n}\r\n\r\n/* desktop: mesma aparência da tabela inline anterior (2fr 1fr 1fr 1fr) */\r\n.fsTable{\r\n  border: 1px solid rgba(255,255,255,.12);\r\n  border-radius: 10px;\r\n  overflow: hidden;\r\n  width: 100%;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  box-sizing: border-box;\r\n}\r\n.fsTrHead{\r\n  display: grid;\r\n  grid-template-columns: 2fr 1fr 1fr 1fr;\r\n  background: #121621;\r\n}\r\n.fsTh{\r\n  padding: 10px 12px;\r\n  font-weight: 800;\r\n  border-left: 1px solid rgba(255,255,255,.06);\r\n}\r\n.fsTr{\r\n  display: grid;\r\n  grid-template-columns: 2fr 1fr 1fr 1fr;\r\n  background: #0f1320;\r\n}\r\n.fsTd{\r\n  padding: 10px 12px;\r\n  border-top: 1px solid rgba(255,255,255,.06);\r\n  border-left: 1px solid rgba(255,255,255,.06);\r\n  min-width: 0;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.fsBigBtn{\r\n  min-width: 180px;\r\n  max-width: 100%;\r\n  box-sizing: border-box;\r\n}\r\n\r\n@media (max-width: 560px){\r\n  .fsCard{ padding: 14px; }\r\n\r\n  /* título centralizado, com folga simétrica que evita o botão ✕ */\r\n  .fsTitle{\r\n    width: 100%;\r\n    box-sizing: border-box;\r\n    text-align: center;\r\n    padding-inline: 40px;\r\n  }\r\n  .fsInfoTitle{\r\n    width: 100%;\r\n    text-align: center;\r\n    margin-bottom: 8px;\r\n  }\r\n\r\n  /* cabeçalho some visualmente mas continua disponível para leitores de tela */\r\n  .fsTrHead{\r\n    position: absolute;\r\n    width: 1px;\r\n    height: 1px;\r\n    padding: 0;\r\n    margin: -1px;\r\n    overflow: hidden;\r\n    clip: rect(0 0 0 0);\r\n    white-space: nowrap;\r\n    border: 0;\r\n  }\r\n\r\n  /* cada linha da tabela vira um card vertical */\r\n  .fsTable{\r\n    border: none;\r\n    border-radius: 0;\r\n    overflow: visible;\r\n    display: grid;\r\n    gap: 8px;\r\n  }\r\n  .fsTr{\r\n    grid-template-columns: minmax(0, 1fr);\r\n    border: 1px solid rgba(255,255,255,.12);\r\n    border-radius: 10px;\r\n    padding: 10px 12px;\r\n  }\r\n  /* célula: rótulo (via data-label) à esquerda, valor à direita */\r\n  .fsTd{\r\n    display: grid;\r\n    grid-template-columns: minmax(110px, 1fr) minmax(0, 1fr);\r\n    gap: 8px;\r\n    align-items: baseline;\r\n    padding: 3px 0;\r\n    border: none;\r\n    text-align: right;\r\n    overflow-wrap: break-word;\r\n  }\r\n  .fsTd::before{\r\n    content: attr(data-label);\r\n    font-weight: 700;\r\n    opacity: .85;\r\n    text-align: left;\r\n  }\r\n  /* 1ª célula (Certificação) vira o título do card, em largura total */\r\n  .fsTd.fsTdName{\r\n    display: block;\r\n    font-weight: 800;\r\n    text-align: left;\r\n    padding: 0 0 6px;\r\n    margin-bottom: 4px;\r\n    border-bottom: 1px solid rgba(255,255,255,.08);\r\n  }\r\n  .fsTd.fsTdName::before{\r\n    content: none;\r\n  }\r\n\r\n  .fsBigBtn{ min-width: 0; width: 100%; }\r\n}\r\n\r\n/* ====== Modal \"Mix de Produtos\": overlay, grade e cards responsivos ====== */\r\n\r\n.mixWrap{\r\n  position: fixed;\r\n  inset: 0;\r\n  background: rgba(0,0,0,.55);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  z-index: 1000;\r\n  padding: 12px;\r\n  box-sizing: border-box;\r\n  overflow-y: auto;\r\n  overflow-x: hidden;\r\n}\r\n\r\n/* border-box: padding + borda contam DENTRO da largura calculada */\r\n.mixCard{\r\n  box-sizing: border-box;\r\n  width: min(980px, calc(100vw - 24px));\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  max-height: 92vh;\r\n  max-height: 92dvh;\r\n  overflow-y: auto;\r\n  overflow-x: hidden;\r\n  background: #1b1f2a;\r\n  color: #e9ecf1;\r\n  border-radius: 16px;\r\n  padding: 20px;\r\n  box-shadow: 0 10px 40px rgba(0,0,0,.4);\r\n  border: 1px solid rgba(255,255,255,.12);\r\n  position: relative;\r\n}\r\n\r\n.mixTitle{\r\n  margin: 6px 0 12px;\r\n  font-weight: 900;\r\n  min-width: 0;\r\n  overflow-wrap: break-word;\r\n}\r\n\r\n.mixCards{\r\n  display: grid;\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n  gap: 12px;\r\n  margin: 8px 0 12px;\r\n  width: 100%;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  box-sizing: border-box;\r\n}\r\n.mixCards > *{\r\n  width: 100%;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  box-sizing: border-box;\r\n  overflow-wrap: break-word;\r\n}\r\n/* badge NÍVEL / estado ADQUIRIDO: sempre contidos no próprio card */\r\n.mixPill{\r\n  width: fit-content;\r\n  max-width: 100%;\r\n  box-sizing: border-box;\r\n}\r\n.mixBuyBtn{\r\n  max-width: 100%;\r\n  box-sizing: border-box;\r\n}\r\n.mixBigBtn{\r\n  min-width: 160px;\r\n  max-width: 100%;\r\n  box-sizing: border-box;\r\n}\r\n\r\n@media (max-width: 760px){\r\n  .mixCards{\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n}\r\n\r\n@media (max-width: 560px){\r\n  .mixCard{ padding: 14px; }\r\n  .mixTitle{ padding-right: 40px; } /* não passa sob o botão ✕ */\r\n  .mixCards{ grid-template-columns: minmax(0, 1fr); }\r\n  /* estado \"Adquirido\" vira faixa em largura total, centralizada no card */\r\n  .mixPillOwned{\r\n    width: 100%;\r\n    text-align: center;\r\n  }\r\n  /* lista vira linhas de leitura direta (semântica de <ul>/<li> preservada) */\r\n  .mixLines{\r\n    list-style: none;\r\n    padding-left: 0;\r\n    display: grid;\r\n    gap: 4px;\r\n  }\r\n  .mixLines > li{\r\n    min-width: 0;\r\n    overflow-wrap: break-word;\r\n  }\r\n  .mixBuyBtn{ width: 100%; }\r\n  .mixBigBtn{ min-width: 0; width: 100%; }\r\n}\r\n\r\n/* ====== Dicas contextuais (somente exibição) ====== */\r\n\r\n/* orientação na lista de salas (subtítulo do cabeçalho) */\r\n.lobbyListHint {\r\n  margin: 6px 0 0;\r\n  font-size: 14px;\r\n  line-height: 1.45;\r\n  color: #aab3c5;\r\n}\r\n\r\n/* faixa de próximo passo na partida (sidebar, acima dos controles) */\r\n.nextStepHint {\r\n  margin: 0 0 8px;\r\n  padding: 7px 10px;\r\n  border-radius: 10px;\r\n  border: 1px solid rgba(255,255,255,.12);\r\n  background: rgba(255,255,255,.05);\r\n  color: #d7def2;\r\n  font-size: 13px;\r\n  line-height: 1.4;\r\n  overflow-wrap: break-word;\r\n  word-break: break-word;\r\n}\r\n.nextStepHintMyTurn {\r\n  border-color: rgba(79,70,229,.75);\r\n  background: rgba(79,70,229,.22);\r\n  color: #eef2ff;\r\n  font-weight: 800;\r\n  box-shadow: 0 0 0 1px rgba(129,140,248,.35), 0 6px 18px rgba(79,70,229,.25);\r\n  animation: nextStepPulse 1.6s ease-in-out infinite;\r\n}\r\n@keyframes nextStepPulse {\r\n  0%, 100% { box-shadow: 0 0 0 1px rgba(129,140,248,.35), 0 6px 18px rgba(79,70,229,.2); }\r\n  50% { box-shadow: 0 0 0 2px rgba(165,180,252,.55), 0 8px 22px rgba(79,70,229,.35); }\r\n}\r\n@media (prefers-reduced-motion: reduce) {\r\n  .nextStepHintMyTurn {\r\n    animation: none;\r\n    transition: none;\r\n  }\r\n}\r\n\r\n/* rótulos financeiros com explicação nativa (title) */\r\n.hudHelp {\r\n  cursor: help;\r\n}\r\n.identityMismatchBanner{\r\n  margin: 0;\r\n  padding: 8px 12px;\r\n  background: rgba(239, 68, 68, 0.16);\r\n  border-bottom: 1px solid rgba(239, 68, 68, 0.35);\r\n  color: #fecaca;\r\n  font-size: 13px;\r\n  line-height: 1.4;\r\n  text-align: center;\r\n}\r\n.hud .score .scorePatrimonioNote{\r\n  margin:0;\r\n  padding:6px 10px 0;\r\n  font-size:11px;\r\n  line-height:1.3;\r\n  color:#aab3c5;\r\n}\r\n.hud .score .scoreValues{\r\n  display:flex;\r\n  flex-direction:column;\r\n  align-items:flex-end;\r\n  gap:2px;\r\n  font-variant-numeric: tabular-nums;\r\n  text-align:right;\r\n}\r\n.hud .score .scorePatrimonio{\r\n  font-weight:800;\r\n  color:#dce4ff;\r\n}\r\n\r\n/* ====== Responsividade: telas pré-partida ====== */\r\n\r\n/* ====== Tela de Lobbies (lista de salas) — somente visual ====== */\r\n\r\n.lobbyPage{\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  box-sizing: border-box;\r\n  padding: 32px 16px;\r\n  display: flex;\r\n  justify-content: center;\r\n  color: #e9ecf1;\r\n  /* fundo escuro com um único detalhe bem discreto no topo */\r\n  background:\r\n    radial-gradient(1000px 560px at 50% -25%, rgba(99,102,241,.10), transparent 60%),\r\n    #0e0f15;\r\n}\r\n.lobbyContainer{\r\n  width: 100%;\r\n  max-width: 1080px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  max-height: calc(100vh - 64px);\r\n  max-height: calc(100dvh - 64px);\r\n  min-height: 0;\r\n}\r\n\r\n/* painel do cabeçalho: ícone + textos + contagens à esquerda, ações à direita */\r\n.lobbyPanel{\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n  padding: 18px 20px;\r\n  margin-bottom: 18px;\r\n  border-radius: 16px;\r\n  border: 1px solid rgba(255,255,255,.09);\r\n  background: rgba(255,255,255,.03);\r\n  box-shadow: 0 8px 20px rgba(0,0,0,.22);\r\n}\r\n.lobbyPanelMain{\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 14px;\r\n  min-width: 0;\r\n  flex: 1 1 320px;\r\n}\r\n.lobbyPanelIcon{\r\n  flex: none;\r\n  width: 44px;\r\n  height: 44px;\r\n  border-radius: 12px;\r\n  display: grid;\r\n  place-items: center;\r\n  color: #a5b4fc;\r\n  background: rgba(99,102,241,.14);\r\n  border: 1px solid rgba(99,102,241,.30);\r\n}\r\n.lobbyPanelIcon svg{ width: 22px; height: 22px; }\r\n.lobbyHeaderText{ min-width: 0; }\r\n.lobbyListTitle{\r\n  margin: 0;\r\n  font-size: 26px;\r\n  font-weight: 800;\r\n  letter-spacing: -.01em;\r\n  color: #fff;\r\n}\r\n.lobbyCounts{\r\n  margin: 8px 0 0;\r\n  font-size: 13px;\r\n  color: #98a2b5;\r\n}\r\n.lobbyCounts b{\r\n  color: #e9ecf1;\r\n  font-weight: 800;\r\n}\r\n.lobbyActions{\r\n  display: flex;\r\n  gap: 10px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n/* botões da tela de lobbies */\r\n.lobbyBtn{\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  padding: 11px 16px;\r\n  border: 0;\r\n  border-radius: 12px;\r\n  font-weight: 800;\r\n  font-size: 14px;\r\n  cursor: pointer;\r\n  transition: box-shadow .15s ease, background .15s ease, border-color .15s ease;\r\n}\r\n.lobbyBtn svg{ width: 16px; height: 16px; flex: none; }\r\n.lobbyBtn:focus-visible{\r\n  outline: 3px solid rgba(199,210,254,.8);\r\n  outline-offset: 2px;\r\n}\r\n.lobbyBtn:disabled{\r\n  opacity: .55;\r\n  cursor: not-allowed;\r\n}\r\n.lobbyBtn--primary{\r\n  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);\r\n  color: #fff;\r\n  box-shadow: 0 6px 18px rgba(79,70,229,.30);\r\n}\r\n.lobbyBtn--primary:hover:not(:disabled){\r\n  box-shadow: 0 10px 24px rgba(79,70,229,.40);\r\n}\r\n.lobbyBtn--ghost{\r\n  background: #1b1e29;\r\n  color: #e9ecf1;\r\n  border: 1px solid rgba(255,255,255,.14);\r\n}\r\n.lobbyBtn--ghost:hover:not(:disabled){\r\n  background: #232735;\r\n  border-color: rgba(255,255,255,.24);\r\n}\r\n\r\n/* ícone do Atualizar girando durante o loading (apenas visual) */\r\n.lobbyRefreshIcon--spinning{\r\n  animation: lobbySpin .9s linear infinite;\r\n}\r\n@keyframes lobbySpin{\r\n  to{ transform: rotate(360deg); }\r\n}\r\n\r\n/* área rolável (o body tem overflow hidden; o scroll é interno e a barra\r\n   só aparece quando as salas ultrapassam a altura disponível) */\r\n.lobbyScrollArea{\r\n  flex: 1 1 auto;\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n  padding-right: 10px;\r\n  scrollbar-gutter: stable;\r\n}\r\n\r\n/* grid de salas */\r\n.lobbyGrid{\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));\r\n  gap: 16px;\r\n  padding-bottom: 8px;\r\n}\r\n\r\n/* card de sala — fundo sólido, detalhe lateral na cor do status */\r\n.lobbyCard{\r\n  --lobby-status: #94a3b8;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n  padding: 16px;\r\n  border-radius: 14px;\r\n  border: 1px solid rgba(255,255,255,.08);\r\n  border-left: 3px solid var(--lobby-status);\r\n  background: #151824;\r\n  box-shadow: 0 6px 16px rgba(0,0,0,.22);\r\n  transition: border-color .15s ease, box-shadow .15s ease;\r\n}\r\n@media (hover: hover){\r\n  .lobbyCard:hover{\r\n    border-color: rgba(255,255,255,.18);\r\n    border-left-color: var(--lobby-status);\r\n    box-shadow: 0 10px 24px rgba(0,0,0,.30);\r\n  }\r\n}\r\n/* cor do detalhe conforme status (somente visual) */\r\n.lobbyCard--open{    --lobby-status: #22c55e; }\r\n.lobbyCard--locked{  --lobby-status: #f59e0b; }\r\n.lobbyCard--playing{ --lobby-status: #8b5cf6; }\r\n.lobbyCard--other{   --lobby-status: #94a3b8; }\r\n\r\n.lobbyCardTop{\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 12px;\r\n  min-width: 0;\r\n}\r\n.lobbyCardAvatar{\r\n  flex: none;\r\n  width: 42px;\r\n  height: 42px;\r\n  border-radius: 12px;\r\n  display: grid;\r\n  place-items: center;\r\n  font-size: 18px;\r\n  font-weight: 900;\r\n  color: #fff;\r\n  background: linear-gradient(135deg, #4f46e5, #7c3aed);\r\n}\r\n.lobbyCardInfo{ min-width: 0; flex: 1; align-self: center; }\r\n.lobbyCardName{\r\n  font-size: 16px;\r\n  font-weight: 800;\r\n  color: #fff;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* bloco central: rótulo, contagem, vagas e barra */\r\n.lobbyCardBody{\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n.lobbyCardPlayersRow{\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n}\r\n.lobbyCardPlayersLabel{\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  letter-spacing: .04em;\r\n  text-transform: uppercase;\r\n  color: #98a2b5;\r\n}\r\n.lobbyCardPlayersLabel svg{ width: 14px; height: 14px; }\r\n.lobbyCardPlayersCount{\r\n  font-size: 14px;\r\n  font-weight: 800;\r\n  color: #fff;\r\n}\r\n\r\n/* círculos de vagas (decorativos; o número já informa a ocupação) */\r\n.lobbySeats{\r\n  display: flex;\r\n  gap: 6px;\r\n}\r\n.lobbySeat{\r\n  width: 10px;\r\n  height: 10px;\r\n  border-radius: 999px;\r\n  border: 1.5px solid rgba(255,255,255,.28);\r\n  background: transparent;\r\n  box-sizing: border-box;\r\n}\r\n.lobbySeat--filled{\r\n  border-color: transparent;\r\n  background: #c7d2fe;\r\n}\r\n\r\n/* barra de ocupação (decorativa; largura vem inline do JSX) */\r\n.lobbyOcc{\r\n  height: 4px;\r\n  border-radius: 999px;\r\n  background: rgba(255,255,255,.06);\r\n  overflow: hidden;\r\n}\r\n.lobbyOccFill{\r\n  height: 100%;\r\n  border-radius: 999px;\r\n  background: rgba(165,180,252,.7);\r\n  transition: width .25s ease;\r\n}\r\n\r\n/* badge de status */\r\n.lobbyBadge{\r\n  padding: 5px 12px;\r\n  border-radius: 999px;\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  letter-spacing: .02em;\r\n  border: 1px solid transparent;\r\n  white-space: nowrap;\r\n}\r\n.lobbyBadge--open{\r\n  color: #4ade80;\r\n  background: rgba(34,197,94,.14);\r\n  border-color: rgba(34,197,94,.35);\r\n}\r\n.lobbyBadge--locked{\r\n  color: #fbbf24;\r\n  background: rgba(245,158,11,.14);\r\n  border-color: rgba(245,158,11,.35);\r\n}\r\n.lobbyBadge--playing{\r\n  color: #c4b5fd;\r\n  background: rgba(124,58,237,.16);\r\n  border-color: rgba(124,58,237,.40);\r\n}\r\n.lobbyBadge--other{\r\n  color: #cbd5e1;\r\n  background: rgba(148,163,184,.14);\r\n  border-color: rgba(148,163,184,.30);\r\n}\r\n\r\n/* botão principal do card (largura total) */\r\n.lobbyJoinBtn{\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  width: 100%;\r\n  padding: 11px 18px;\r\n  border: 0;\r\n  border-radius: 10px;\r\n  font-weight: 800;\r\n  font-size: 14px;\r\n  color: #fff;\r\n  cursor: pointer;\r\n  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);\r\n  box-shadow: 0 6px 16px rgba(79,70,229,.28);\r\n  transition: box-shadow .15s ease, opacity .15s ease;\r\n}\r\n.lobbyJoinBtn svg{ width: 16px; height: 16px; flex: none; }\r\n.lobbyJoinBtn:hover:not(:disabled){\r\n  box-shadow: 0 10px 22px rgba(79,70,229,.40);\r\n}\r\n.lobbyJoinBtn:focus-visible{\r\n  outline: 3px solid rgba(216,180,254,.85);\r\n  outline-offset: 2px;\r\n}\r\n.lobbyJoinBtn:disabled{\r\n  background: rgba(255,255,255,.06);\r\n  color: #8b93a7;\r\n  cursor: not-allowed;\r\n  box-shadow: none;\r\n}\r\n\r\n/* skeleton de carregamento (visual puro; respeita reduced-motion) */\r\n.lobbySkelCard{ pointer-events: none; }\r\n.lobbySkel{\r\n  display: block;\r\n  border-radius: 8px;\r\n  background: rgba(255,255,255,.07);\r\n  animation: lobbySkelPulse 1.4s ease-in-out infinite;\r\n}\r\n.lobbySkelAvatar{\r\n  flex: none;\r\n  width: 42px;\r\n  height: 42px;\r\n  border-radius: 12px;\r\n}\r\n.lobbySkelLine{ height: 12px; }\r\n.lobbySkelLine--lg{ width: 70%; margin-bottom: 8px; }\r\n.lobbySkelLine--sm{ width: 45%; }\r\n.lobbySkelBadge{\r\n  width: 64px;\r\n  height: 24px;\r\n  border-radius: 999px;\r\n  margin-left: auto;\r\n}\r\n.lobbySkelBar{ height: 4px; border-radius: 999px; }\r\n.lobbySkelBtn{ height: 42px; border-radius: 10px; }\r\n@keyframes lobbySkelPulse{\r\n  0%, 100%{ opacity: 1; }\r\n  50%{ opacity: .45; }\r\n}\r\n\r\n/* estado vazio */\r\n.lobbyEmpty{\r\n  margin-top: 16px;\r\n  padding: 40px 20px;\r\n  border-radius: 16px;\r\n  border: 1px dashed rgba(255,255,255,.15);\r\n  background: rgba(255,255,255,.02);\r\n  text-align: center;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.lobbyEmptyIcon{\r\n  width: 64px;\r\n  height: 64px;\r\n  border-radius: 16px;\r\n  display: grid;\r\n  place-items: center;\r\n  color: #8b93a7;\r\n  background: rgba(255,255,255,.04);\r\n  border: 1px solid rgba(255,255,255,.10);\r\n  margin-bottom: 4px;\r\n}\r\n.lobbyEmptyIcon svg{ width: 32px; height: 32px; }\r\n.lobbyEmptyTitle{\r\n  font-size: 18px;\r\n  font-weight: 800;\r\n  color: #fff;\r\n}\r\n.lobbyEmptyText{\r\n  margin: 0 0 10px;\r\n  max-width: 420px;\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n  color: #aab3c5;\r\n}\r\n\r\n/* ====== Modal \"Criar sala\" (interface local; substitui o prompt nativo) ====== */\r\n\r\n/* backdrop escuro com leve blur; rola verticalmente se a tela for baixa */\r\n.lobbyModalBackdrop{\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 1000;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 16px;\r\n  padding-bottom: max(16px, env(safe-area-inset-bottom));\r\n  box-sizing: border-box;\r\n  background: rgba(8,9,14,.62);\r\n  backdrop-filter: blur(4px);\r\n  -webkit-backdrop-filter: blur(4px);\r\n  overflow-y: auto;\r\n}\r\n.lobbyModal{\r\n  box-sizing: border-box;\r\n  width: min(460px, calc(100% - 24px));\r\n  max-height: calc(100dvh - 32px);\r\n  overflow-y: auto;\r\n  margin: auto; /* centraliza e mantém acessível quando o backdrop rola */\r\n  padding: 20px;\r\n  border-radius: 18px;\r\n  border: 1px solid rgba(255,255,255,.10);\r\n  border-top: 2px solid rgba(124,58,237,.55); /* detalhe roxo discreto */\r\n  background: #151824;\r\n  box-shadow: 0 24px 60px rgba(0,0,0,.50);\r\n  animation: lobbyModalIn .16s ease-out;\r\n}\r\n@keyframes lobbyModalIn{\r\n  from{ opacity: 0; transform: translateY(8px) scale(.98); }\r\n  to{ opacity: 1; transform: none; }\r\n}\r\n\r\n.lobbyModalHeader{\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 12px;\r\n}\r\n.lobbyModalIcon{\r\n  flex: none;\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 12px;\r\n  display: grid;\r\n  place-items: center;\r\n  color: #a5b4fc;\r\n  background: rgba(99,102,241,.14);\r\n  border: 1px solid rgba(99,102,241,.30);\r\n}\r\n.lobbyModalIcon svg{ width: 20px; height: 20px; }\r\n.lobbyModalHeading{ min-width: 0; flex: 1; }\r\n.lobbyModalTitle{\r\n  margin: 0;\r\n  font-size: 18px;\r\n  font-weight: 800;\r\n  color: #fff;\r\n}\r\n.lobbyModalSubtitle{\r\n  margin: 4px 0 0;\r\n  font-size: 13px;\r\n  line-height: 1.45;\r\n  color: #98a2b5;\r\n}\r\n.lobbyModalClose{\r\n  flex: none;\r\n  width: 36px;\r\n  height: 36px;\r\n  display: grid;\r\n  place-items: center;\r\n  border: 1px solid rgba(255,255,255,.12);\r\n  border-radius: 10px;\r\n  background: transparent;\r\n  color: #98a2b5;\r\n  cursor: pointer;\r\n  transition: background .15s ease, color .15s ease, border-color .15s ease;\r\n}\r\n.lobbyModalClose:hover:not(:disabled){ background: rgba(255,255,255,.06); color: #fff; }\r\n.lobbyModalClose:focus-visible{\r\n  outline: 3px solid rgba(199,210,254,.8);\r\n  outline-offset: 2px;\r\n}\r\n.lobbyModalClose:disabled{\r\n  opacity: .45;\r\n  cursor: not-allowed;\r\n}\r\n.lobbyModalClose svg{ width: 16px; height: 16px; }\r\n\r\n.lobbyModalBody{\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 18px;\r\n  margin-top: 18px;\r\n}\r\n.lobbyModalField{\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n.lobbyModalLabel{\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  color: #cbd3e1;\r\n}\r\n.lobbyModalInput{\r\n  box-sizing: border-box;\r\n  width: 100%;\r\n  min-height: 44px;\r\n  padding: 12px 14px;\r\n  border-radius: 10px;\r\n  border: 1px solid rgba(255,255,255,.14);\r\n  background: #0f1119;\r\n  color: #fff;\r\n  font-size: 16px;\r\n  outline: none;\r\n  transition: border-color .15s ease, box-shadow .15s ease;\r\n}\r\n.lobbyModalInput:focus-visible{\r\n  border-color: #7c3aed;\r\n  box-shadow: 0 0 0 3px rgba(124,58,237,.28);\r\n}\r\n.lobbyModalInput--error{ border-color: #ef4444; }\r\n.lobbyModalInput--error:focus-visible{\r\n  border-color: #ef4444;\r\n  box-shadow: 0 0 0 3px rgba(239,68,68,.25);\r\n}\r\n.lobbyModalHelp{\r\n  margin: 0;\r\n  font-size: 12px;\r\n  color: #8b93a7;\r\n}\r\n.lobbyModalError{\r\n  margin: 0;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: #f87171;\r\n}\r\n/* erro geral do modal (falha ao criar/entrar na sala) */\r\n.lobbyModalSubmitError{\r\n  margin: 0;\r\n  padding: 10px 12px;\r\n  border-radius: 10px;\r\n  border: 1px solid rgba(239,68,68,.35);\r\n  background: rgba(239,68,68,.12);\r\n  font-size: 13px;\r\n  line-height: 1.45;\r\n  color: #fca5a5;\r\n}\r\n.lobbyModalFooter{\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  gap: 10px;\r\n}\r\n\r\n/* animações reduzidas para quem prefere menos movimento */\r\n@media (prefers-reduced-motion: reduce){\r\n  .lobbyRefreshIcon--spinning{ animation: none; }\r\n  .lobbySkel{ animation: none; }\r\n  .lobbyModal{ animation: none; }\r\n  .lobbyCard,\r\n  .lobbyBtn,\r\n  .lobbyJoinBtn,\r\n  .lobbyModalClose,\r\n  .lobbyModalInput,\r\n  .lobbyOccFill{ transition: none; }\r\n}\r\n\r\n/* ====== Sala de jogadores (pré-partida) — somente visual ====== */\r\n\r\n.playerLobbyPage{\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  /* a própria página rola verticalmente (o body global usa overflow hidden) */\r\n  height: 100vh;\r\n  height: 100dvh;\r\n  overflow-y: auto;\r\n  overflow-x: hidden;\r\n  overscroll-behavior-y: contain;\r\n  -webkit-overflow-scrolling: touch;\r\n  box-sizing: border-box;\r\n  padding: 32px 16px;\r\n  display: flex;\r\n  justify-content: center;\r\n  color: #f8fafc;\r\n  /* fundo escuro com um único brilho bem discreto */\r\n  background:\r\n    radial-gradient(1000px 560px at 50% -25%, rgba(109,93,252,.10), transparent 60%),\r\n    #0e0f15;\r\n}\r\n.playerLobbyContainer{\r\n  width: 100%;\r\n  max-width: 1100px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n}\r\n\r\n/* --- cabeçalho da sala --- */\r\n.playerLobbyHero{\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  padding: 18px 20px;\r\n  border-radius: 16px;\r\n  border: 1px solid rgba(255,255,255,.09);\r\n  background: #151824;\r\n  box-shadow: 0 8px 20px rgba(0,0,0,.22);\r\n}\r\n.playerLobbyBackBtn{\r\n  flex: none;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  min-height: 44px;\r\n  padding: 10px 14px;\r\n  border-radius: 12px;\r\n  border: 1px solid rgba(255,255,255,.14);\r\n  background: #1b1e29;\r\n  color: #f8fafc;\r\n  font-weight: 800;\r\n  font-size: 14px;\r\n  cursor: pointer;\r\n  transition: background .15s ease, border-color .15s ease;\r\n}\r\n.playerLobbyBackBtn svg{ width: 16px; height: 16px; flex: none; }\r\n@media (hover: hover){\r\n  .playerLobbyBackBtn:hover{ background: #232735; border-color: rgba(255,255,255,.24); }\r\n}\r\n.playerLobbyBackBtn:focus-visible{\r\n  outline: 3px solid rgba(199,210,254,.8);\r\n  outline-offset: 2px;\r\n}\r\n.playerLobbyHeroIcon{\r\n  flex: none;\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: 13px;\r\n  display: grid;\r\n  place-items: center;\r\n  color: #a5b4fc;\r\n  background: rgba(109,93,252,.14);\r\n  border: 1px solid rgba(109,93,252,.32);\r\n}\r\n.playerLobbyHeroIcon svg{ width: 24px; height: 24px; }\r\n.playerLobbyHeroContent{ min-width: 0; flex: 1; }\r\n.playerLobbyTitle{\r\n  margin: 0;\r\n  font-size: 24px;\r\n  font-weight: 800;\r\n  letter-spacing: -.01em;\r\n  color: #fff;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.playerLobbySubtitle{\r\n  margin: 2px 0 0;\r\n  font-size: 13px;\r\n  color: #aab3c5;\r\n}\r\n.playerLobbyMeta{\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  flex-wrap: wrap;\r\n  margin-top: 8px;\r\n}\r\n.playerLobbyMetaItem{\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font-size: 13px;\r\n  color: #aab3c5;\r\n}\r\n.playerLobbyMetaItem svg{ width: 14px; height: 14px; flex: none; }\r\n.playerLobbyStatusBadge{\r\n  padding: 4px 12px;\r\n  border-radius: 999px;\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  letter-spacing: .02em;\r\n  border: 1px solid transparent;\r\n  white-space: nowrap;\r\n}\r\n.playerLobbyStatusBadge--open{\r\n  color: #4ade80;\r\n  background: rgba(34,197,94,.14);\r\n  border-color: rgba(34,197,94,.35);\r\n}\r\n.playerLobbyStatusBadge--locked{\r\n  color: #fbbf24;\r\n  background: rgba(245,158,11,.14);\r\n  border-color: rgba(245,158,11,.35);\r\n}\r\n.playerLobbyStatusBadge--playing{\r\n  color: #c4b5fd;\r\n  background: rgba(139,92,246,.16);\r\n  border-color: rgba(139,92,246,.40);\r\n}\r\n.playerLobbyStatusBadge--other{\r\n  color: #cbd5e1;\r\n  background: rgba(148,163,184,.14);\r\n  border-color: rgba(148,163,184,.30);\r\n}\r\n\r\n/* --- painéis (jogadores e configurações) --- */\r\n.playerLobbyPanel{\r\n  padding: 18px 20px;\r\n  border-radius: 16px;\r\n  border: 1px solid rgba(255,255,255,.09);\r\n  background: #151824;\r\n  box-shadow: 0 6px 16px rgba(0,0,0,.20);\r\n}\r\n.playerLobbyPanelHeader{ margin-bottom: 14px; }\r\n.playerLobbyPanelTitle{\r\n  margin: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 16px;\r\n  font-weight: 800;\r\n  color: #fff;\r\n}\r\n.playerLobbyPanelTitle svg{ width: 16px; height: 16px; flex: none; color: #a5b4fc; }\r\n.playerLobbyPanelHint{\r\n  margin: 4px 0 0;\r\n  font-size: 13px;\r\n  line-height: 1.45;\r\n  color: #aab3c5;\r\n}\r\n\r\n/* --- progresso de prontos --- */\r\n.playerLobbyProgress{ margin-bottom: 14px; }\r\n.playerLobbyProgressHeader{\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n  font-size: 13px;\r\n  color: #aab3c5;\r\n  margin-bottom: 6px;\r\n}\r\n.playerLobbyProgressHeader b{ color: #fff; font-weight: 800; }\r\n.playerLobbyProgressTrack{\r\n  height: 6px;\r\n  border-radius: 999px;\r\n  background: rgba(255,255,255,.07);\r\n  overflow: hidden;\r\n}\r\n.playerLobbyProgressFill{\r\n  height: 100%;\r\n  border-radius: 999px;\r\n  background: #22c55e;\r\n  transition: width .25s ease;\r\n}\r\n\r\n.playerLobbyLoading{\r\n  padding: 14px 4px;\r\n  font-size: 14px;\r\n  color: #aab3c5;\r\n}\r\n\r\n/* --- lista de jogadores --- */\r\n.playerLobbyPlayers{\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n.playerLobbyPlayerCard{\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 12px 14px;\r\n  border-radius: 12px;\r\n  border: 1px solid rgba(255,255,255,.08);\r\n  background: #191c29;\r\n  transition: border-color .15s ease;\r\n}\r\n@media (hover: hover){\r\n  .playerLobbyPlayerCard:hover{ border-color: rgba(255,255,255,.16); }\r\n}\r\n.playerLobbyAvatar{\r\n  flex: none;\r\n  width: 44px;\r\n  height: 44px;\r\n  border-radius: 12px;\r\n  display: grid;\r\n  place-items: center;\r\n  font-size: 18px;\r\n  font-weight: 900;\r\n  color: #fff;\r\n  background: linear-gradient(135deg, #6d5dfc, #8b5cf6);\r\n}\r\n.playerLobbyPlayerInfo{ min-width: 0; flex: 1; }\r\n.playerLobbyPlayerName{\r\n  font-size: 15px;\r\n  font-weight: 800;\r\n  color: #fff;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.playerLobbyBadges{\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n  margin-top: 4px;\r\n}\r\n.playerLobbyBadge{\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  padding: 3px 10px;\r\n  border-radius: 999px;\r\n  font-size: 11.5px;\r\n  font-weight: 800;\r\n  letter-spacing: .02em;\r\n  border: 1px solid transparent;\r\n  white-space: nowrap;\r\n}\r\n.playerLobbyBadge svg{ width: 12px; height: 12px; flex: none; }\r\n.playerLobbyBadge--host{\r\n  color: #fbbf24;\r\n  background: rgba(251,191,36,.12);\r\n  border-color: rgba(251,191,36,.35);\r\n}\r\n\r\n/* Selo Host durante a partida (topbar) — compacto, sem alterar altura do layout */\r\n.gameHostBadge{\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 3px;\r\n  margin-left: 6px;\r\n  padding: 2px 7px;\r\n  border-radius: 999px;\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: .02em;\r\n  line-height: 1.2;\r\n  white-space: nowrap;\r\n  color: #fbbf24;\r\n  background: rgba(251,191,36,.12);\r\n  border: 1px solid rgba(251,191,36,.35);\r\n  vertical-align: middle;\r\n  max-width: 42vw;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n.gameHostBadge--other{\r\n  color: #e7c66a;\r\n  background: rgba(251,191,36,.08);\r\n  border-color: rgba(251,191,36,.28);\r\n  font-weight: 700;\r\n}\r\n.playerLobbyBadge--me{\r\n  color: #93c5fd;\r\n  background: rgba(96,165,250,.12);\r\n  border-color: rgba(96,165,250,.35);\r\n}\r\n.playerLobbyBadge--ready{\r\n  color: #4ade80;\r\n  background: rgba(34,197,94,.14);\r\n  border-color: rgba(34,197,94,.35);\r\n}\r\n.playerLobbyBadge--waiting{\r\n  color: #cbd5e1;\r\n  background: rgba(148,163,184,.12);\r\n  border-color: rgba(148,163,184,.28);\r\n}\r\n\r\n/* --- botão Ficar pronto / Marcar como não pronto --- */\r\n.playerLobbyReadyBtn{\r\n  flex: none;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  min-height: 44px;\r\n  padding: 10px 16px;\r\n  border: 1px solid transparent;\r\n  box-sizing: border-box;\r\n  border-radius: 12px;\r\n  font-weight: 800;\r\n  font-size: 14px;\r\n  color: #fff;\r\n  cursor: pointer;\r\n  background: linear-gradient(135deg, #6d5dfc, #8b5cf6);\r\n  box-shadow: 0 6px 16px rgba(109,93,252,.28);\r\n  transition: box-shadow .15s ease, background .15s ease, border-color .15s ease;\r\n}\r\n.playerLobbyReadyBtn svg{ width: 16px; height: 16px; flex: none; }\r\n@media (hover: hover){\r\n  .playerLobbyReadyBtn:hover:not(:disabled){ box-shadow: 0 10px 22px rgba(109,93,252,.40); }\r\n}\r\n.playerLobbyReadyBtn:focus-visible{\r\n  outline: 3px solid rgba(199,210,254,.8);\r\n  outline-offset: 2px;\r\n}\r\n.playerLobbyReadyBtn:disabled{\r\n  opacity: .55;\r\n  cursor: not-allowed;\r\n  box-shadow: none;\r\n}\r\n/* quando já está pronto, a ação de desfazer vira secundária */\r\n.playerLobbyReadyBtn--undo{\r\n  background: #1b1e29;\r\n  border: 1px solid rgba(255,255,255,.14);\r\n  box-shadow: none;\r\n  color: #e9ecf1;\r\n}\r\n@media (hover: hover){\r\n  .playerLobbyReadyBtn--undo:hover:not(:disabled){\r\n    background: #232735;\r\n    border-color: rgba(255,255,255,.24);\r\n    box-shadow: none;\r\n  }\r\n}\r\n\r\n/* --- seletor de rodadas --- */\r\n.playerLobbyRounds{\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n.playerLobbyRoundBtn{\r\n  min-width: 48px;\r\n  min-height: 44px;\r\n  padding: 10px 12px;\r\n  border-radius: 10px;\r\n  border: 1px solid rgba(255,255,255,.14);\r\n  background: #191c29;\r\n  color: #f8fafc;\r\n  font-weight: 800;\r\n  font-size: 15px;\r\n  cursor: pointer;\r\n  transition: background .15s ease, border-color .15s ease, box-shadow .15s ease;\r\n}\r\n@media (hover: hover){\r\n  .playerLobbyRoundBtn:hover:not(:disabled){\r\n    background: #202433;\r\n    border-color: rgba(255,255,255,.24);\r\n  }\r\n}\r\n.playerLobbyRoundBtn:focus-visible{\r\n  outline: 3px solid rgba(199,210,254,.8);\r\n  outline-offset: 2px;\r\n}\r\n.playerLobbyRoundBtn--active{\r\n  background: #6d5dfc;\r\n  border-color: rgba(199,210,254,.55);\r\n  box-shadow: 0 0 0 3px rgba(109,93,252,.22);\r\n}\r\n.playerLobbyRoundSelection{\r\n  margin: 12px 0 0;\r\n  font-size: 14px;\r\n  color: #e9ecf1;\r\n}\r\n.playerLobbyRoundSelection b{ color: #fff; font-weight: 800; }\r\n.playerLobbyRoundNote{\r\n  margin: 8px 0 0;\r\n  font-size: 12px;\r\n  color: #8b93a7;\r\n}\r\n\r\n/* --- cronômetro de turno --- */\r\n.turnTimer{\r\n  min-width: 88px;\r\n  padding: 4px 10px 6px;\r\n  border-radius: 10px;\r\n  border: 1px solid rgba(255,255,255,.14);\r\n  background: rgba(0,0,0,.28);\r\n  text-align: center;\r\n  line-height: 1.15;\r\n}\r\n.turnTimerLabel{\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  letter-spacing: .04em;\r\n  text-transform: uppercase;\r\n  color: rgba(255,255,255,.65);\r\n}\r\n.turnTimerValue{\r\n  font-size: 18px;\r\n  font-weight: 800;\r\n  font-variant-numeric: tabular-nums;\r\n  color: #fff;\r\n}\r\n.turnTimerTrack{\r\n  margin-top: 4px;\r\n  height: 4px;\r\n  border-radius: 999px;\r\n  background: rgba(255,255,255,.12);\r\n  overflow: hidden;\r\n}\r\n.turnTimerFill{\r\n  height: 100%;\r\n  border-radius: inherit;\r\n  background: #6d5dfc;\r\n  transition: width .2s linear;\r\n}\r\n.turnTimer--urgent{\r\n  border-color: rgba(255, 120, 90, .55);\r\n}\r\n.turnTimer--urgent .turnTimerValue{ color: #ffb4a2; }\r\n.turnTimer--urgent .turnTimerFill{ background: #ff7a59; }\r\n.turnTimer--paused{\r\n  opacity: .85;\r\n}\r\n.turnTimerPauseHint{\r\n  margin-top: 2px;\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  color: rgba(255,255,255,.55);\r\n}\r\n.topbarSecondary{\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n/* --- painel inferior: status, mensagem e ações --- */\r\n.playerLobbyFooter{\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n  padding: 16px 20px;\r\n  border-radius: 16px;\r\n  border: 1px solid rgba(255,255,255,.09);\r\n  background: #151824;\r\n  box-shadow: 0 6px 16px rgba(0,0,0,.20);\r\n}\r\n.playerLobbyStatusGroup{\r\n  display: flex;\r\n  gap: 24px;\r\n  flex: none;\r\n}\r\n.playerLobbyStatusItem{\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n.playerLobbyStatusLabel{\r\n  font-size: 11.5px;\r\n  font-weight: 700;\r\n  letter-spacing: .04em;\r\n  text-transform: uppercase;\r\n  color: #8b93a7;\r\n}\r\n.playerLobbyStatusValue{\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  font-size: 14px;\r\n  font-weight: 800;\r\n  color: #f8fafc;\r\n}\r\n.playerLobbyDot{\r\n  width: 8px;\r\n  height: 8px;\r\n  border-radius: 50%;\r\n  background: #94a3b8;\r\n}\r\n.playerLobbyDot--open{ background: #22c55e; }\r\n.playerLobbyDot--locked{ background: #fbbf24; }\r\n.playerLobbyDot--playing{ background: #8b5cf6; }\r\n.playerLobbyMessageArea{\r\n  flex: 1 1 260px;\r\n  min-width: 0;\r\n}\r\n.playerLobbyMessage{\r\n  margin: 0;\r\n  font-size: 13.5px;\r\n  line-height: 1.45;\r\n  color: #aab3c5;\r\n}\r\n.playerLobbyWarning{\r\n  margin: 8px 0 0;\r\n  padding: 8px 12px;\r\n  border-radius: 10px;\r\n  border: 1px solid rgba(251,191,36,.35);\r\n  background: rgba(251,191,36,.10);\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  color: #fbbf24;\r\n}\r\n.playerLobbyActions{\r\n  display: flex;\r\n  gap: 10px;\r\n  flex: none;\r\n}\r\n.playerLobbyStartBtn{\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  min-height: 48px;\r\n  padding: 12px 20px;\r\n  border: 0;\r\n  box-sizing: border-box;\r\n  border-radius: 12px;\r\n  font-weight: 800;\r\n  font-size: 15px;\r\n  color: #fff;\r\n  cursor: pointer;\r\n  background: linear-gradient(135deg, #6d5dfc 0%, #8b5cf6 100%);\r\n  box-shadow: 0 6px 18px rgba(109,93,252,.30);\r\n  transition: box-shadow .15s ease;\r\n}\r\n.playerLobbyStartBtn svg{ width: 16px; height: 16px; flex: none; }\r\n@media (hover: hover){\r\n  .playerLobbyStartBtn:hover:not(:disabled){ box-shadow: 0 10px 24px rgba(109,93,252,.42); }\r\n}\r\n.playerLobbyStartBtn:focus-visible{\r\n  outline: 3px solid rgba(199,210,254,.8);\r\n  outline-offset: 2px;\r\n}\r\n.playerLobbyStartBtn:disabled{\r\n  background: rgba(255,255,255,.07);\r\n  color: #8b93a7;\r\n  cursor: not-allowed;\r\n  box-shadow: none;\r\n}\r\n.playerLobbyLeaveBtn{\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  min-height: 44px;\r\n  padding: 11px 16px;\r\n  border-radius: 12px;\r\n  border: 1px solid rgba(255,255,255,.14);\r\n  background: transparent;\r\n  color: #e9ecf1;\r\n  font-weight: 800;\r\n  font-size: 14px;\r\n  cursor: pointer;\r\n  transition: background .15s ease, border-color .15s ease, color .15s ease;\r\n}\r\n.playerLobbyLeaveBtn svg{ width: 16px; height: 16px; flex: none; }\r\n@media (hover: hover){\r\n  .playerLobbyLeaveBtn:hover{\r\n    background: rgba(248,113,113,.10);\r\n    border-color: rgba(248,113,113,.40);\r\n    color: #f87171;\r\n  }\r\n}\r\n.playerLobbyLeaveBtn:focus-visible{\r\n  outline: 3px solid rgba(254,202,202,.7);\r\n  outline-offset: 2px;\r\n}\r\n\r\n/* movimento reduzido */\r\n@media (prefers-reduced-motion: reduce){\r\n  .playerLobbyBackBtn,\r\n  .playerLobbyPlayerCard,\r\n  .playerLobbyReadyBtn,\r\n  .playerLobbyRoundBtn,\r\n  .playerLobbyStartBtn,\r\n  .playerLobbyLeaveBtn,\r\n  .playerLobbyProgressFill{ transition: none; }\r\n}\r\n\r\n@media (max-width: 560px){\r\n  /* Lista de salas: layout compacto em telas pequenas */\r\n  .lobbyPage{ padding: 20px 12px; }\r\n  .lobbyContainer{\r\n    max-height: calc(100vh - 40px);\r\n    max-height: calc(100dvh - 40px);\r\n  }\r\n  .lobbyPanel{ padding: 16px 14px; }\r\n  .lobbyListTitle{ font-size: 22px; }\r\n  .lobbyActions{ width: 100%; }\r\n  .lobbyActions .lobbyBtn{ flex: 1 1 auto; min-height: 44px; }\r\n  .lobbyJoinBtn{ min-height: 44px; }\r\n  .lobbyScrollArea{ padding-right: 6px; }\r\n\r\n  /* Modal \"Criar sala\": padding menor e botões dividindo a largura */\r\n  .lobbyModalBackdrop{ padding: 12px; }\r\n  .lobbyModal{ padding: 16px; }\r\n  .lobbyModalFooter .lobbyBtn{ flex: 1 1 auto; min-height: 44px; }\r\n\r\n  /* Sala de jogadores (pré-partida): layout empilhado */\r\n  .playerLobbyPage{ padding: 20px 12px; }\r\n  .playerLobbyHero{\r\n    flex-wrap: wrap;\r\n    padding: 14px;\r\n    gap: 12px;\r\n  }\r\n  .playerLobbyBackBtn{ order: -1; width: 100%; }\r\n  .playerLobbyTitle{ font-size: 20px; }\r\n  .playerLobbyPanel{ padding: 14px; }\r\n\r\n  /* jogador vira card vertical; botão Pronto em largura total */\r\n  .playerLobbyPlayerCard{\r\n    flex-wrap: wrap;\r\n    align-items: flex-start;\r\n  }\r\n  .playerLobbyReadyBtn{ width: 100%; }\r\n\r\n  /* seleção de rodadas distribuída */\r\n  .playerLobbyRounds{ width: 100%; }\r\n  .playerLobbyRoundBtn{ flex: 1 1 auto; }\r\n\r\n  /* painel inferior empilhado, botões em largura total */\r\n  .playerLobbyFooter{\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n    padding: 14px;\r\n  }\r\n  .playerLobbyStatusGroup{ justify-content: space-between; }\r\n  .playerLobbyActions{ flex-direction: column; }\r\n  .playerLobbyStartBtn,\r\n  .playerLobbyLeaveBtn{ width: 100%; }\r\n}\r\n\r\n/* ====== Responsividade: tela da partida (mobile) ======\r\n   Bloco no FINAL do arquivo para vencer, pela cascata, as regras\r\n   duplicadas de .content/.side/.boardWrap definidas acima. */\r\n@media (max-width: 760px){\r\n  /* a página vira o container de scroll vertical (html/body seguem intactos) */\r\n  .page{\r\n    height: 100vh;\r\n    overflow-y: auto;\r\n    overflow-x: hidden;\r\n  }\r\n\r\n  /* topbar aceita quebra de linha sem sobrepor o tabuleiro */\r\n  .topbar{\r\n    height: auto;\r\n    min-height: var(--topbar-h);\r\n    flex-wrap: wrap;\r\n    row-gap: 4px;\r\n  }\r\n\r\n  /* empilha: tabuleiro (primeiro no DOM) e sidebar abaixo */\r\n  .content{\r\n    flex-direction: column;\r\n    height: auto;\r\n    overflow: visible;\r\n  }\r\n\r\n  /* ===== Modo \"Tabuleiro inteiro\" (fit — padrão) =====\r\n     Tabuleiro completo na largura disponível, proporção original,\r\n     sem nenhuma rolagem horizontal. */\r\n  .boardWrap{\r\n    width: 100%;\r\n    max-width: 100%;\r\n    min-width: 0;\r\n    height: auto;\r\n    flex: 0 0 auto;\r\n    overflow-x: hidden;\r\n  }\r\n  .board{\r\n    width: 100%;\r\n    min-width: 0;\r\n    max-width: 100%;\r\n    height: auto;\r\n    aspect-ratio: 800 / 700;\r\n  }\r\n\r\n  /* ===== Modo foco (follow — edge-to-edge) =====\r\n     Tabuleiro inteiro na largura FÍSICA do celular: só o .boardWrap rompe\r\n     as margens laterais do .content (truque margin-left: 50% - 50vw);\r\n     botão e sidebar continuam dentro das margens normais. Sem scroll\r\n     horizontal e sem distorção (aspect-ratio preservado). */\r\n  .content--boardFocus .boardWrap{\r\n    box-sizing: border-box;\r\n    width: 100vw;\r\n    width: 100dvw;\r\n    max-width: 100vw;\r\n    max-width: 100dvw;\r\n    min-width: 0;\r\n    margin-left: calc(50% - 50vw);\r\n    margin-left: calc(50% - 50dvw);\r\n    overflow: hidden;\r\n    justify-content: center;\r\n  }\r\n  .content--boardFocus .board{\r\n    box-sizing: border-box;\r\n    width: 100%;\r\n    min-width: 0;\r\n    max-width: 100%;\r\n    height: auto;\r\n    aspect-ratio: 800 / 700;\r\n    flex: 0 0 auto;\r\n  }\r\n\r\n  /* botão de alternância dos modos (só mobile) */\r\n  .boardModeBtn{\r\n    display: block;\r\n    width: 100%;\r\n    min-height: 40px;\r\n    padding: 10px 14px;\r\n    margin: 0 0 8px;\r\n    border: 1px solid rgba(255,255,255,.16);\r\n    border-radius: 10px;\r\n    background: #20222a;\r\n    color: #fff;\r\n    font-weight: 800;\r\n    font-size: 14px;\r\n    text-align: center;\r\n    cursor: pointer;\r\n    grid-column: 1 / -1;\r\n    box-sizing: border-box;\r\n  }\r\n  .boardModeBtn:focus-visible{\r\n    outline: 3px solid rgba(255,255,255,.85);\r\n    outline-offset: 2px;\r\n  }\r\n\r\n  /* sidebar em largura total, sem altura/rolagem próprias */\r\n  .side{\r\n    width: 100%;\r\n    min-width: 0;\r\n    height: auto;\r\n    max-height: none;\r\n    overflow: visible;\r\n  }\r\n\r\n  /* tokens no mobile: `scale` (propriedade individual) compõe com o\r\n     translate(-50%,-50%) inline sem sobrescrevê-lo; com transform-origin 0 0,\r\n     o centro do peão permanece exatamente na coordenada calculada da casa.\r\n     scale 0.90: em board de ~320px o token fica com ~14px (ativo ~17px),\r\n     ainda menor que uma casa. */\r\n  .token{\r\n    transform-origin: 0 0;\r\n    scale: 0.90;\r\n    /* contorno escuro externo (outline não entra na animação de box-shadow\r\n       do ativo nem afeta layout) + sombra curta e forte p/ áreas claras */\r\n    outline: 1px solid rgba(0,0,0,.6);\r\n    box-shadow:\r\n      0 0 0 1px rgba(0,0,0,.35),\r\n      0 2px 5px rgba(0,0,0,.65),\r\n      0 6px 12px rgba(0,0,0,.3);\r\n  }\r\n  /* peça ativa: compensa o TOKEN_ACTIVE_SCALE (1.15) inline do Board.jsx.\r\n     0.78 × 1.15 ≈ 0.90 → mesmo tamanho físico da peça normal; a identificação\r\n     da vez fica por conta do halo e da estrela. */\r\n  .token.token--active{\r\n    scale: 0.78;\r\n    /* halo mais contido no mobile (mesma animação, spread menor) */\r\n    animation-name: sgTokenPulseMobile;\r\n  }\r\n  /* estrela da vez mais legível: disco escuro atrás, presa ao próprio token */\r\n  .tokenTurnBadge{\r\n    font-size: .48em;\r\n    background: rgba(15,19,32,.85);\r\n    border-radius: 999px;\r\n    padding: .08em;\r\n  }\r\n  @keyframes sgTokenPulseMobile{\r\n    0%, 100%{\r\n      box-shadow:\r\n        0 0 0 1px rgba(0,0,0,.55),\r\n        0 0 0 2px var(--token-color, #6c5ce7),\r\n        0 0 6px 2px var(--token-color, #6c5ce7),\r\n        0 4px 10px rgba(0,0,0,.45);\r\n    }\r\n    50%{\r\n      box-shadow:\r\n        0 0 0 1px rgba(0,0,0,.55),\r\n        0 0 0 2px var(--token-color, #6c5ce7),\r\n        0 0 10px 3px var(--token-color, #6c5ce7),\r\n        0 4px 10px rgba(0,0,0,.45);\r\n    }\r\n  }\r\n}\r\n\r\n/* ====== Mobile portrait: partida compacta (não afeta landscape/desktop) ====== */\r\n@media (max-width: 760px) and (orientation: portrait){\r\n  /*\r\n   * Documento vertical: html/body liberam scroll (base global é overflow:hidden).\r\n   * Sem isso, .page com height:100vh + Safari chrome corta HUD/placar,\r\n   * sobretudo com tabuleiro expandido.\r\n   */\r\n  html, body{\r\n    height: auto;\r\n    min-height: 100%;\r\n    overflow-x: hidden;\r\n    overflow-y: auto;\r\n    -webkit-overflow-scrolling: touch;\r\n  }\r\n\r\n  .page{\r\n    display: flex;\r\n    flex-direction: column;\r\n    height: auto;\r\n    min-height: 100dvh;\r\n    max-height: none;\r\n    overflow-x: hidden;\r\n    overflow-y: visible;\r\n    padding-bottom: calc(24px + env(safe-area-inset-bottom, 0px));\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  /*\r\n   * Cabeçalho em coluna previsível.\r\n   * L1 jogador → L2 métricas → L3 rodada/caixa → (gap) → botão → tabuleiro.\r\n   */\r\n  .topbar{\r\n    display: flex;\r\n    flex-direction: column;\r\n    flex-wrap: nowrap;\r\n    align-items: stretch;\r\n    justify-content: flex-start;\r\n    height: auto;\r\n    min-height: 0;\r\n    max-height: none;\r\n    padding: 8px 10px;\r\n    gap: 8px;\r\n    row-gap: 8px;\r\n    column-gap: 0;\r\n    overflow: visible;\r\n    position: relative;\r\n    z-index: 2;\r\n    flex: 0 0 auto;\r\n  }\r\n\r\n  .topbar .status,\r\n  .topbar .topbarPrimary,\r\n  .topbar .topbarSecondary{\r\n    display: flex;\r\n    flex-direction: column;\r\n    flex: 0 0 auto;\r\n    flex-wrap: nowrap;\r\n    align-items: stretch;\r\n    justify-content: flex-start;\r\n    gap: 6px;\r\n    width: 100%;\r\n    max-width: 100%;\r\n    min-width: 0;\r\n    box-sizing: border-box;\r\n    font-size: 12px;\r\n    line-height: 1.25;\r\n    font-weight: 600;\r\n  }\r\n\r\n  .topbar .topbarRow{\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    align-items: center;\r\n    gap: 6px 10px;\r\n    width: 100%;\r\n    min-width: 0;\r\n  }\r\n\r\n  .topbar .topbarRow--player{\r\n    flex-wrap: nowrap;\r\n  }\r\n\r\n  .gameHostBadge{\r\n    font-size: 10px;\r\n    padding: 1px 6px;\r\n    margin-left: 4px;\r\n    max-width: 36vw;\r\n  }\r\n\r\n  .topbar .topbarDot{\r\n    flex: 0 0 auto;\r\n  }\r\n\r\n  .topbar .topbarName{\r\n    flex: 1 1 auto;\r\n    min-width: 0;\r\n    overflow-wrap: anywhere;\r\n    padding: 4px 10px;\r\n  }\r\n\r\n  .topbar .topbarRow--metrics{\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    align-items: center;\r\n    column-gap: 12px;\r\n    row-gap: 4px;\r\n  }\r\n\r\n  .topbar .topbarSecondary{\r\n    flex-direction: row;\r\n    flex-wrap: wrap;\r\n    align-items: center;\r\n    gap: 6px 10px;\r\n  }\r\n\r\n  .topbar .money{\r\n    padding: 4px 8px;\r\n    font-size: 12px;\r\n  }\r\n\r\n  .debugToggle{\r\n    display: none !important;\r\n  }\r\n\r\n  /* Conteúdo: fluxo de documento, sem limite de viewport */\r\n  .content,\r\n  .content--boardFocus{\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n    flex: 0 0 auto;\r\n    height: auto;\r\n    min-height: 0;\r\n    max-height: none;\r\n    overflow: visible;\r\n    padding-top: 0;\r\n  }\r\n\r\n  .boardModeBtn{\r\n    position: static;\r\n    display: block;\r\n    width: 100%;\r\n    max-width: 100%;\r\n    box-sizing: border-box;\r\n    flex: 0 0 auto;\r\n    order: 0;\r\n    min-height: 40px;\r\n    padding: 10px 12px;\r\n    margin: 10px 0 12px;\r\n    font-size: 13px;\r\n    border-radius: 8px;\r\n    transform: none;\r\n    top: auto;\r\n    left: auto;\r\n    z-index: auto;\r\n  }\r\n\r\n  /* Tabuleiro no fluxo; expandido só altera largura */\r\n  .boardWrap,\r\n  .boardWrap--follow,\r\n  .content--boardFocus .boardWrap{\r\n    position: relative;\r\n    top: auto;\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    flex: 0 0 auto;\r\n    order: 1;\r\n    max-height: none;\r\n    overflow-x: hidden;\r\n    overflow-y: visible;\r\n  }\r\n\r\n  .boardWrap:not(.boardWrap--follow){\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n  }\r\n  .boardWrap:not(.boardWrap--follow) .board{\r\n    aspect-ratio: 800 / 700;\r\n    width: min(100%, calc(clamp(240px, 38vh, 320px) * 800 / 700));\r\n    width: min(100%, calc(clamp(240px, 38dvh, 320px) * 800 / 700));\r\n    height: auto;\r\n    max-width: 100%;\r\n  }\r\n\r\n  .content--boardFocus .boardWrap,\r\n  .content--boardFocus .boardWrap--follow{\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n    height: auto;\r\n    max-height: none;\r\n    overflow-x: hidden;\r\n    overflow-y: visible;\r\n  }\r\n\r\n  .content--boardFocus .board,\r\n  .boardWrap--follow .board{\r\n    height: auto;\r\n    max-height: none;\r\n  }\r\n\r\n  /*\r\n   * Sidebar: SEM scroll interno / SEM max-height de viewport.\r\n   * (Base .side e regra .side{max-height:calc(100vh-88px)} cortavam o HUD.)\r\n   */\r\n  .side{\r\n    display: flex;\r\n    flex-direction: column;\r\n    order: 2;\r\n    width: 100%;\r\n    min-width: 0;\r\n    max-width: 100%;\r\n    height: auto;\r\n    max-height: none;\r\n    overflow: visible;\r\n    flex: none;\r\n    gap: 8px;\r\n    padding-right: 0;\r\n    padding-bottom: 8px;\r\n  }\r\n\r\n  /* Controles no fluxo (não sticky no rodapé) */\r\n  .side > .controlsSticky,\r\n  .controlsSticky{\r\n    order: 1;\r\n    position: static;\r\n    bottom: auto;\r\n    top: auto;\r\n    z-index: auto;\r\n    padding: 6px 4px 4px;\r\n    box-shadow: none;\r\n    backdrop-filter: none;\r\n    background: transparent;\r\n    border-top: none;\r\n  }\r\n  .side > .hud{\r\n    order: 2;\r\n    min-width: 0;\r\n    height: auto;\r\n    max-height: none;\r\n    overflow: visible;\r\n  }\r\n\r\n  .controlsSticky .diceResult{\r\n    margin-bottom: 6px;\r\n    padding: 8px 10px;\r\n  }\r\n  .controlsSticky .diceResultDie{\r\n    width: 48px;\r\n    height: 48px;\r\n  }\r\n  .controlsSticky .diceResultLabel{\r\n    font-size: 12px;\r\n  }\r\n  .controlsSticky .diceResultPlayer{\r\n    font-size: 13px;\r\n  }\r\n  .controlsSticky .nextStepHint{\r\n    margin: 0 0 6px;\r\n    font-size: 12px;\r\n    line-height: 1.3;\r\n  }\r\n  .controlsSticky .controls{\r\n    padding: 6px;\r\n    gap: 6px;\r\n  }\r\n  .controlsSticky .btn{\r\n    padding: 10px 12px;\r\n    font-size: 14px;\r\n    min-height: 44px;\r\n  }\r\n\r\n  /* HUD: reaproveita “Ver detalhes” (markup já existente) */\r\n  .hud .panel{\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 4px;\r\n    padding: 6px 8px;\r\n    box-sizing: border-box;\r\n  }\r\n  .hudMetricsPrimary{\r\n    display: grid;\r\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\r\n    gap: 2px 8px;\r\n    min-width: 0;\r\n    order: 1;\r\n  }\r\n  .hudMetricsPrimary--capacity{\r\n    order: 2;\r\n  }\r\n  .hudDetailsToggle{\r\n    display: block;\r\n    box-sizing: border-box;\r\n    width: 100%;\r\n    margin: 0;\r\n    padding: 6px 8px;\r\n    border: 1px solid rgba(255,255,255,.16);\r\n    border-radius: 6px;\r\n    background: #242a38;\r\n    color: #e8ecf4;\r\n    font-size: 12px;\r\n    font-weight: 700;\r\n    line-height: 1.2;\r\n    cursor: pointer;\r\n    text-align: center;\r\n    order: 3;\r\n  }\r\n  .hudDetailsToggle:hover,\r\n  .hudDetailsToggle:focus-visible{\r\n    background: #2e3648;\r\n    outline: 2px solid rgba(120, 160, 255, 0.55);\r\n    outline-offset: 1px;\r\n  }\r\n  .hudMetricsSecondary{\r\n    display: none;\r\n    min-width: 0;\r\n    order: 4;\r\n  }\r\n  .hudMetricsSecondary.is-open{\r\n    display: grid;\r\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\r\n    gap: 2px 8px;\r\n  }\r\n  .hud .line,\r\n  .hudMetric{\r\n    margin: 0;\r\n    font-size: 12px;\r\n    line-height: 1.25;\r\n    min-width: 0;\r\n    overflow-wrap: normal;\r\n    word-break: normal;\r\n  }\r\n  .hudMetric--wide{\r\n    grid-column: 1 / -1;\r\n  }\r\n\r\n  .hud .score{\r\n    display: grid;\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n    gap: 2px 6px;\r\n    margin-top: 6px;\r\n  }\r\n  .hud .score .title{\r\n    grid-column: 1 / -1;\r\n    padding: 5px 8px;\r\n    font-size: 12px;\r\n  }\r\n  .hud .score .row{\r\n    min-width: 0;\r\n    padding: 4px 6px;\r\n    font-size: 12px;\r\n    line-height: 1.2;\r\n  }\r\n}\r\n\r\n/* ====== Mobile landscape: documento rolável + 2 colunas ======\r\n   Estratégia simples (sem cqw/cqh, sem scroll interno na .side):\r\n   - scroll principal = html/body (evita ficar preso ao girar do portrait)\r\n   - board limitado por max-height em dvh + max-width da coluna (AR 800/700)\r\n   - boardWrap sticky à esquerda; side no fluxo do documento\r\n   - text-size-adjust:100% evita inflação de texto do iOS no landscape\r\n   - boardFocus: board sozinho cabendo na viewport (sem edge-to-edge portrait)\r\n   Não altera .token nem regras de peões. Não altera portrait. */\r\n@media (max-width: 960px) and (orientation: landscape){\r\n  html, body{\r\n    width: 100%;\r\n    max-width: 100%;\r\n    height: auto;\r\n    min-height: 100%;\r\n    overflow-x: hidden;\r\n    overflow-y: auto;\r\n    -webkit-overflow-scrolling: touch;\r\n    -webkit-text-size-adjust: 100%;\r\n    text-size-adjust: 100%;\r\n  }\r\n\r\n  /* index.html fixa height:100% no #root — liberar para o documento crescer */\r\n  #root{\r\n    height: auto;\r\n    min-height: 100%;\r\n    max-width: 100%;\r\n    overflow-x: hidden;\r\n  }\r\n\r\n  .page{\r\n    display: flex;\r\n    flex-direction: column;\r\n    width: 100%;\r\n    max-width: 100%;\r\n    min-width: 0;\r\n    height: auto;\r\n    min-height: 100dvh;\r\n    max-height: none;\r\n    overflow: visible;\r\n    overflow-x: hidden;\r\n    box-sizing: border-box;\r\n    padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));\r\n  }\r\n\r\n  .topbar{\r\n    height: auto;\r\n    min-height: 0;\r\n    max-height: none;\r\n    width: 100%;\r\n    max-width: 100%;\r\n    min-width: 0;\r\n    padding: 4px 8px;\r\n    flex: 0 0 auto;\r\n    flex-wrap: nowrap;\r\n    overflow-x: auto;\r\n    overflow-y: hidden;\r\n    row-gap: 0;\r\n    box-sizing: border-box;\r\n  }\r\n  .topbar .status{\r\n    flex-wrap: nowrap;\r\n    gap: 8px;\r\n    font-size: clamp(11px, 1.5vw, 13px);\r\n    min-width: 0;\r\n  }\r\n\r\n  /*\r\n   * Duas colunas equilibradas (~52/48). height:auto — a página rola.\r\n   * Neutraliza column/100dvw do bloco ≤760px quando ambos aplicam.\r\n   */\r\n  .content,\r\n  .content--boardFocus{\r\n    display: grid;\r\n    grid-template-columns: minmax(0, 52%) minmax(0, 48%);\r\n    grid-template-rows: auto;\r\n    align-items: start;\r\n    justify-items: stretch;\r\n    box-sizing: border-box;\r\n    width: 100%;\r\n    max-width: 100%;\r\n    height: auto;\r\n    min-height: 0;\r\n    min-width: 0;\r\n    overflow: visible;\r\n    overflow-x: hidden;\r\n    padding: 6px 8px;\r\n    gap: 8px;\r\n    flex: 0 0 auto;\r\n  }\r\n\r\n  /* Modo normal: botão oculto (economiza altura). Expandido: ver abaixo. */\r\n  .boardModeBtn{\r\n    display: none;\r\n  }\r\n\r\n  /*\r\n   * Board wrap: coluna 1, sticky, sem container queries.\r\n   * Anula 100vw/100dvw + margin negativa do portrait boardFocus.\r\n   */\r\n  .boardWrap,\r\n  .content--boardFocus .boardWrap,\r\n  .boardWrap--follow,\r\n  .content--boardFocus .boardWrap--follow{\r\n    grid-column: 1;\r\n    grid-row: 1;\r\n    box-sizing: border-box;\r\n    position: sticky;\r\n    top: 0;\r\n    align-self: start;\r\n    width: 100%;\r\n    max-width: 100%;\r\n    min-width: 0;\r\n    height: auto;\r\n    max-height: none;\r\n    min-height: 0;\r\n    margin: 0;\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n    flex: none;\r\n    overflow: visible;\r\n    display: flex;\r\n    align-items: flex-start;\r\n    justify-content: center;\r\n    container-type: normal;\r\n  }\r\n\r\n  /*\r\n   * Board INTEIRO na altura visual: max-height em dvh define o teto;\r\n   * width = min(coluna, altura×800/700). Sem cqw/cqh.\r\n   * --sg-board-max-h ≈ viewport − topbar − paddings.\r\n   */\r\n  .board,\r\n  .content--boardFocus .board,\r\n  .boardWrap--follow .board,\r\n  .content--boardFocus .boardWrap--follow .board{\r\n    --sg-board-max-h: calc(100dvh - 52px - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px));\r\n    box-sizing: border-box;\r\n    aspect-ratio: 800 / 700;\r\n    width: min(100%, calc(var(--sg-board-max-h) * 800 / 700));\r\n    max-width: 100%;\r\n    height: auto;\r\n    max-height: var(--sg-board-max-h);\r\n    flex: 0 0 auto;\r\n    margin: 0;\r\n  }\r\n\r\n  .boardImg{\r\n    width: 100%;\r\n    height: 100%;\r\n    display: block;\r\n    object-fit: fill;\r\n    margin: 0;\r\n  }\r\n\r\n  /* Sidebar no fluxo do documento — SEM scroll interno */\r\n  .side{\r\n    --side-w: 100%;\r\n    grid-column: 2;\r\n    grid-row: 1;\r\n    display: flex;\r\n    flex-direction: column;\r\n    box-sizing: border-box;\r\n    width: 100%;\r\n    max-width: 100%;\r\n    min-width: 0;\r\n    height: auto;\r\n    max-height: none;\r\n    min-height: 0;\r\n    flex: none;\r\n    flex-basis: auto;\r\n    overflow: visible;\r\n    overflow-x: hidden;\r\n    gap: 6px;\r\n    padding-right: 0;\r\n    padding-bottom: 8px;\r\n    font-size: clamp(11px, 1.5vw, 13px);\r\n    -webkit-text-size-adjust: 100%;\r\n    text-size-adjust: 100%;\r\n  }\r\n\r\n  .side > .hud{\r\n    order: 2;\r\n    min-width: 0;\r\n    min-height: 0;\r\n    height: auto;\r\n    max-height: none;\r\n    flex: 0 0 auto;\r\n    overflow: visible;\r\n  }\r\n\r\n  .hud .panel{\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 4px;\r\n    padding: 6px 8px;\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  .hudMetricsPrimary{\r\n    display: grid;\r\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\r\n    gap: 2px 8px;\r\n    min-width: 0;\r\n    order: 1;\r\n  }\r\n  .hudMetricsPrimary--capacity{\r\n    order: 2;\r\n  }\r\n\r\n  .hudDetailsToggle{\r\n    display: block;\r\n    box-sizing: border-box;\r\n    width: 100%;\r\n    margin: 0;\r\n    padding: 5px 8px;\r\n    border: 1px solid rgba(255,255,255,.16);\r\n    bord