const __vite__css = "/* ===== Página ocupando 100% e SEM rolagem global ===== */\r\nhtml, body {\r\n  height: 100%;\r\n  overflow: hidden;\r\n}\r\n\r\n/* =========================================================\r\n   LobbyList - scrollbar visível\r\n   (o app desliga a rolagem global, então o scroll precisa ser\r\n   interno. Isso também ajuda quando o Windows/Chrome auto-ocultam\r\n   a barra.)\r\n========================================================= */\r\n\r\n.lobbyScroll {\r\n  /* auto: a barra só aparece quando o conteúdo ultrapassa a altura;\r\n     scrollbar-gutter: stable evita \"pulo\" de layout quando ela surge */\r\n  overflow-y: auto;\r\n  scrollbar-gutter: stable;\r\n  scrollbar-width: thin; /* Firefox */\r\n}\r\n\r\n.lobbyScroll::-webkit-scrollbar {\r\n  width: 12px;\r\n}\r\n\r\n.lobbyScroll::-webkit-scrollbar-thumb {\r\n  background: rgba(255,255,255,0.18);\r\n  border-radius: 10px;\r\n  border: 3px solid rgba(0,0,0,0.25);\r\n}\r\n\r\n.lobbyScroll::-webkit-scrollbar-track {\r\n  background: rgba(0,0,0,0.20);\r\n  border-radius: 10px;\r\n}\r\n\r\n:root{\r\n  --side-w: 270px;         /* largura da coluna direita (HUD + botões) */\r\n  --topbar-h: 38px;        /* altura aproximada da barra do topo */\r\n  --gap: 10px;\r\n  --pad: 10px;\r\n}\r\n\r\n/* ===== Estrutura ===== */\r\n.page{\r\n  display:flex; flex-direction:column;\r\n  height:100vh;\r\n  color:#eee; font-family:Inter,ui-sans-serif,system-ui;\r\n}\r\n\r\n.topbar{\r\n  height: var(--topbar-h);\r\n  display:flex; align-items:center; justify-content:space-between;\r\n  padding:6px 10px; background:#1a1a1a; border-bottom:1px solid #2a2a2a;\r\n}\r\n.topbar .icons .icon{ margin-right:8px; font-size:18px }\r\n.topbar .status{ display:flex; gap:14px; align-items:center; font-weight:600; font-size:14px }\r\n.topbar .money{ background:#2a2a2a; padding:6px 10px; border-radius:8px }\r\n/* Wrappers do cabeçalho: no desktop/landscape os filhos participam do flex do .status\r\n   (layout plano). Em portrait o media query redefine .topbarRow como linhas reais. */\r\n.topbar .topbarRow{ display: contents; }\r\n.topbar .topbarDot{ display:inline-block; flex:0 0 auto; }\r\n\r\n/* Área útil da viewport (sem rolar) */\r\n.content{\r\n  display:flex; gap:var(--gap); padding:var(--pad);\r\n  height: calc(100vh - var(--topbar-h));\r\n  min-height: 0;\r\n  overflow: hidden;  /* nada rola aqui */\r\n}\r\n\r\n/* ===== Coluna da esquerda (só o tabuleiro) ===== */\r\n.boardWrap{\r\n  flex:1 1 auto; min-width:0;\r\n  height: 100%;                /* ocupa 100% da área útil */\r\n  display:flex; align-items:center; justify-content:center;\r\n}\r\n\r\n/* Botão de modo do tabuleiro: recurso exclusivamente mobile.\r\n   Fica no DOM, mas só aparece dentro do media query ≤760px. */\r\n.boardModeBtn{\r\n  display: none;\r\n}\r\n\r\n/* Tabuleiro preenche 100% da área disponível */\r\n.board{\r\n  position: relative;\r\n  width: 100%;\r\n  height: 100%;\r\n  background:#111;\r\n  border:1px solid #2a2a2a;\r\n  border-radius:8px;\r\n  overflow:hidden;\r\n  box-shadow:0 10px 30px rgba(0,0,0,.35);\r\n}\r\n.boardImg{\r\n  width:100%;\r\n  height:100%;\r\n  display:block;\r\n  object-fit: fill;   /* cobre tudo como no seu layout */\r\n  margin:0;\r\n}\r\n\r\n/* Overlay de preços ERP/SISTEMAS (Board clássico) — preso ao board, sem interação */\r\n.erpPriceOverlayLayer{\r\n  position:absolute;\r\n  inset:0;\r\n  pointer-events:none;\r\n  z-index:2;\r\n}\r\n.erpPriceOverlay{\r\n  position:absolute;\r\n  pointer-events:none;\r\n  box-sizing:border-box;\r\n  display:flex;\r\n  flex-direction:column;\r\n  justify-content:center;\r\n  align-items:center;\r\n  text-align:center;\r\n  /* Cyan original das casas ERP ~ rgb(1,177,234) */\r\n  background:#01b1ea;\r\n  color:#fff;\r\n  font-weight:800;\r\n  line-height:1.12;\r\n  letter-spacing:0.01em;\r\n  padding:1% 2%;\r\n  overflow:hidden;\r\n  font-family: Arial, Helvetica, sans-serif;\r\n}\r\n.erpPriceOverlayLine{\r\n  display:block;\r\n  white-space:nowrap;\r\n}\r\n\r\n/* Peões\r\n   Posição, tamanho, cor (--token-color) e largura do anel vêm inline do\r\n   Board.jsx; aqui fica só o acabamento visual. O translate(-50%,-50%) inline\r\n   mantém o centro exato na coordenada da casa. */\r\n.token{\r\n  position:absolute;\r\n  border-radius:50%;\r\n  display:grid;\r\n  place-items:center;\r\n  /* brilho no topo + cor do jogador = leve volume 3D */\r\n  background:\r\n    radial-gradient(circle at 30% 28%, rgba(255,255,255,.4), rgba(255,255,255,0) 55%),\r\n    var(--token-color, #6c5ce7);\r\n  border:3px solid rgba(255,255,255,.95); /* largura real vem do inline */\r\n  box-shadow: 0 3px 10px rgba(0,0,0,.55), 0 8px 18px rgba(0,0,0,.35);\r\n  color:#fff;\r\n  font-weight:900;\r\n  user-select:none;\r\n  pointer-events:none; /* apenas visual; movimento é por botão */\r\n  transform:translate(-50%,-50%);\r\n  /* left/top ~ TOKEN_STEP_MS (150ms) em Board.jsx — movimento casa a casa */\r\n  transition:\r\n    width .25s ease,\r\n    height .25s ease,\r\n    box-shadow .25s ease,\r\n    left 150ms linear,\r\n    top 150ms linear;\r\n}\r\n@media (prefers-reduced-motion: reduce){\r\n  /* Mantém left/top (movimento casa a casa); só desliga pulse decorativo */\r\n  .token--active{\r\n    animation: none;\r\n  }\r\n}\r\n.tokenInitial{\r\n  line-height:1;\r\n  text-shadow: 0 1px 2px rgba(0,0,0,.75), 0 0 3px rgba(0,0,0,.45);\r\n}\r\n/* jogador da vez: halo na cor do jogador + pulse sutil (sem piscar) */\r\n.token--active{\r\n  animation: sgTokenPulse 1.8s ease-in-out infinite;\r\n}\r\n/* Desktop: pulse anima box-shadow; misturar box-shadow na transition do\r\n   mesmo elemento pode cancelar left/top no Chromium (peão “pula” ao destino).\r\n   Mobile (max-width:760px) não redefine transition e já funciona — não tocar. */\r\n@media (min-width: 761px){\r\n  .token.token--active{\r\n    transition:\r\n      width .25s ease,\r\n      height .25s ease,\r\n      left 150ms linear,\r\n      top 150ms linear;\r\n  }\r\n}\r\n@media (min-width: 761px) and (prefers-reduced-motion: reduce){\r\n  .token.token--active{\r\n    /* left/top permanecem; só para o pulse */\r\n    transition:\r\n      width .25s ease,\r\n      height .25s ease,\r\n      left 150ms linear,\r\n      top 150ms linear;\r\n    animation: none;\r\n  }\r\n}\r\n.tokenTurnBadge{\r\n  position:absolute;\r\n  top:0;\r\n  right:0;\r\n  transform: translate(35%, -35%);\r\n  font-size:.55em;\r\n  line-height:1;\r\n  filter: drop-shadow(0 1px 2px rgba(0,0,0,.5));\r\n}\r\n@keyframes sgTokenPulse{\r\n  0%, 100%{\r\n    box-shadow:\r\n      0 0 0 1px rgba(0,0,0,.55),\r\n      0 0 0 4px var(--token-color, #6c5ce7),\r\n      0 0 12px 3px var(--token-color, #6c5ce7),\r\n      0 6px 16px rgba(0,0,0,.45);\r\n  }\r\n  50%{\r\n    box-shadow:\r\n      0 0 0 1px rgba(0,0,0,.55),\r\n      0 0 0 4px var(--token-color, #6c5ce7),\r\n      0 0 20px 7px var(--token-color, #6c5ce7),\r\n      0 6px 16px rgba(0,0,0,.45);\r\n  }\r\n}\r\n\r\n/* ===== Coluna da direita (HUD + botões) — SEM rolagem ===== */\r\n.side{\r\n  width:var(--side-w); min-width:var(--side-w);\r\n  height: 100%;                      /* mesma altura da área útil */\r\n  display:flex; flex-direction:column; gap:var(--gap);\r\n  overflow: hidden;                  /* 🔒 remove a rolagem dessa coluna */\r\n  padding-right: 0;\r\n}\r\n\r\n/* Painéis / HUD */\r\n.hud .panel{ background:#171717; border:1px solid #2a2a2a; border-radius:10px; padding:10px; }\r\n.hud .line{ margin:3px 0; font-size:14px }\r\n.hud .pos{ color:#7be77b } .hud .neg{ color:#ff7b7b }\r\n.hud .score{ background:#171717; border:1px solid #2a2a2a; border-radius:10px; margin-top:8px; }\r\n.hud .score .title{ background:#2a2a2a; padding:8px 10px; border-radius:10px 10px 0 0; font-weight:800; }\r\n.hud .score .row{ display:flex; justify-content:space-between; padding:8px 10px; border-top:1px dashed #2a2a2a; }\r\n\r\n/* Wrappers do HUD: transparentes no desktop/portrait (não alteram o fluxo) */\r\n.hudMetricsPrimary,\r\n.hudMetricsSecondary{\r\n  display: contents;\r\n}\r\n.hudDetailsToggle{\r\n  display: none;\r\n}\r\n\r\n/* Botões */\r\n.controls{ background:#171717; border:1px solid #2a2a2a; border-radius:10px; padding:10px; display:flex; flex-direction:column; gap:8px; }\r\n.btn{ padding:12px; border:none; border-radius:10px; font-weight:800; cursor:pointer; }\r\n.btn.primary{ background:#b21e4b; color:#fff; }\r\n.btn.dark{ background:#333; color:#fff; }\r\n.btn.go{ background:#4f46e5; color:#fff; }\r\n.turnBox{ display:flex; flex-direction:column; gap:8px }\r\n\r\n/* Rodapé removido p/ não sobrar faixa preta */\r\n.foot{ display:none; }\r\n\r\n/* ===== Modais (mantidos) ===== */\r\n.modalBackdrop{\r\n  position:fixed; inset:0; background:rgba(0,0,0,.55);\r\n  display:flex; align-items:center; justify-content:center; z-index:1000;\r\n}\r\n.modalCard{ background:transparent; border:none; padding:0; box-shadow:none; }\r\n.bankruptcyModal .paper{\r\n  position: relative;\r\n  padding: 18px 20px;\r\n  border-radius: 26px;\r\n  background: #f6e2bd;\r\n  border: 2px solid #d1b98d;\r\n  box-shadow: 0 6px 18px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.4);\r\n}\r\n.bankruptcyModal p{ margin:0 0 14px; color:#222; font-size:16px; line-height:1.35; }\r\n.bankruptcyModal .actions{ display:flex; gap:14px; align-items:center; }\r\n.pill{ min-width:140px; padding:10px 18px; border-radius:10px; font-weight:800; border:0; cursor:pointer; box-shadow:0 2px 0 rgba(0,0,0,.18), 0 8px 18px rgba(0,0,0,.15); }\r\n.btn-cancel{ background:#1b6e63; color:#fff; }\r\n.btn-yes{ background:#c2185b; color:#fff; }\r\n\r\n/* Acessibilidade dos botões desabilitados */\r\n.btn[disabled], .btn[aria-disabled=\"true\"]{\r\n  opacity:.55; cursor:not-allowed; filter:saturate(.7);\r\n}\r\n\r\n/* ===== Breakpoints ===== */\r\n@media (max-width:1150px){\r\n  :root{ --side-w: 240px; }\r\n  .topbar .status{ gap:10px; font-size:13px }\r\n}\r\n@media (max-width:980px){\r\n  :root{ --side-w: 220px; }\r\n}\r\n\r\n/* ===== Overlay de marcadores (números das casas) ===== */\r\n.markersLayer{\r\n  position:absolute; inset:0;\r\n  pointer-events:none;   /* não bloqueia cliques no tabuleiro */\r\n}\r\n\r\n.marker{\r\n  position:absolute;\r\n  transform: translate(-50%,-50%);\r\n  width: 26px; height: 26px;\r\n  border-radius: 50%;\r\n  background: rgba(79,70,229,.85); /* roxinho */\r\n  color:#fff; font-weight:800; font-size:12px;\r\n  display:flex; align-items:center; justify-content:center;\r\n  box-shadow: 0 2px 6px rgba(0,0,0,.35);\r\n  user-select: none;\r\n}\r\n\r\n\r\n/* ===== Gravador de trilha ===== */\r\n.recLayer{\r\n  position:absolute; inset:0;\r\n  cursor: crosshair;\r\n  background: transparent;\r\n}\r\n\r\n.recDotsLayer{\r\n  position:absolute; inset:0;\r\n  pointer-events: none;\r\n}\r\n\r\n.recDot{\r\n  position:absolute;\r\n  transform: translate(-50%,-50%);\r\n  width: 26px; height: 26px;\r\n  border-radius: 50%;\r\n  background: rgba(0,0,0,.75);\r\n  color:#fff; font-weight:800; font-size:12px;\r\n  display:flex; align-items:center; justify-content:center;\r\n  border:2px solid #fff;\r\n  box-shadow: 0 2px 6px rgba(0,0,0,.4);\r\n  user-select: none;\r\n}\r\n\r\n.recToolbar{\r\n  position:absolute; left:12px; right:12px; bottom:12px;\r\n  display:flex; align-items:center; justify-content:space-between;\r\n  gap:10px;\r\n  background: rgba(20,20,20,.85);\r\n  border:1px solid #2a2a2a;\r\n  border-radius:10px;\r\n  padding:8px 10px;\r\n  color:#eee;\r\n}\r\n\r\n.recInfo{ display:flex; gap:14px; align-items:center; font-size:14px }\r\n.recBtns{ display:flex; gap:8px; }\r\n.recBtns button{\r\n  background:#333; color:#fff; border:none; border-radius:8px; padding:8px 10px;\r\n  font-weight:700; cursor:pointer;\r\n}\r\n.recBtns button[disabled]{ opacity:.55; cursor:not-allowed; }\r\n\r\n/* ===== Landing / Start Screen ===== */\r\n.start{\r\n  position:fixed; inset:0; z-index:999;   /* deixe z-index alto enquanto estiver ativa */\r\n  display:flex; flex-direction:column;\r\n  overflow:hidden; background:#000;\r\n  font-family: Inter, ui-sans-serif, system-ui;\r\n  color:#fff;\r\n}\r\n.startBg{\r\n  position:absolute; inset:0; width:100%; height:100%;\r\n  object-fit:cover; filter:saturate(1.1) contrast(1.05) brightness(.95);\r\n}\r\n.startShade{\r\n  position:absolute; inset:0;\r\n  background: radial-gradient(60% 60% at 45% 45%, rgba(0,0,0,.0) 0%, rgba(0,0,0,.25) 60%, rgba(0,0,0,.55) 100%);\r\n  pointer-events:none;\r\n}\r\n.startHeader{\r\n  position:relative; z-index:1;\r\n  display:flex; justify-content:center; padding:24px 16px 8px;\r\n}\r\n.startLogo{\r\n  width:min(520px, 60vw);\r\n  filter: drop-shadow(0 12px 28px rgba(0,0,0,.45));\r\n}\r\n\r\n.startCenter{\r\n  position:relative; z-index:1;\r\n  flex:1; display:flex; align-items:center; justify-content:center;\r\n  padding:16px;\r\n}\r\n.startCard{\r\n  width:min(520px, 100%);\r\n  background: rgba(18,18,18,.72);\r\n  border:1px solid rgba(255,255,255,.1);\r\n  border-radius:16px;\r\n  padding:22px;\r\n  box-shadow: 0 20px 60px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.06);\r\n  backdrop-filter: blur(6px);\r\n}\r\n.startLabel{\r\n  display:block; font-weight:700; letter-spacing:.2px; margin:0 0 6px 4px; color:#dfe7ff;\r\n}\r\n.startInput{\r\n  width:100%; height:46px; border-radius:10px; border:1px solid rgba(255,255,255,.16);\r\n  background:rgba(0,0,0,.35); color:#fff; padding:0 14px;\r\n  outline:none; font-size:16px;\r\n}\r\n.startInput::placeholder{ color:#aab3cc; }\r\n.startInput:focus{\r\n  border-color:#6ea8ff; box-shadow:0 0 0 3px rgba(110,168,255,.25);\r\n}\r\n.startBtn{\r\n  width:100%; height:52px; margin-top:14px;\r\n  border:none; border-radius:12px; cursor:pointer; font-weight:900; letter-spacing:.4px;\r\n  background:#4f46e5; color:#fff;\r\n  box-shadow: 0 10px 30px rgba(79,70,229,.45);\r\n}\r\n.startBtn:hover{ filter:brightness(1.05); transform:translateY(-1px); }\r\n.startBtn:active{ transform:translateY(0); }\r\n.startBtn:disabled,\r\n.startBtn[aria-disabled=\"true\"]{\r\n  opacity:.45; cursor:not-allowed; transform:none; filter:none;\r\n}\r\n\r\n/* ---- StartScreen: orientação e resumo (pontual) ---- */\r\n.startHint{\r\n  margin:0 0 14px;\r\n  font-size:15px;\r\n  line-height:1.45;\r\n  color:#d7def2;\r\n  opacity:.95;\r\n}\r\n.startSummary{\r\n  margin:0 0 16px;\r\n  padding:12px 14px;\r\n  border-radius:12px;\r\n  border:1px solid rgba(255,255,255,.12);\r\n  background:rgba(0,0,0,.28);\r\n  display:flex;\r\n  flex-direction:column;\r\n  gap:8px;\r\n}\r\n.startSummary p{\r\n  margin:0;\r\n  font-size:14px;\r\n  line-height:1.4;\r\n  color:#e8edf8;\r\n}\r\n.startSummary strong{ color:#fff; font-weight:800; }\r\n.startSummaryNote{\r\n  font-size:13px !important;\r\n  opacity:.85;\r\n  color:#c5cee0 !important;\r\n}\r\n.startBtnSecondary{\r\n  width:100%; height:48px; margin-top:10px;\r\n  border-radius:12px; cursor:pointer; font-weight:800; letter-spacing:.3px;\r\n  background:transparent; color:#e8edf8;\r\n  border:1px solid rgba(255,255,255,.22);\r\n}\r\n.startBtnSecondary:hover{ background:rgba(255,255,255,.06); }\r\n\r\n/* Tutorial inicial em etapas (tela inicial) */\r\n.tutorialModal{\r\n  padding:20px 22px 18px;\r\n  max-height:min(80vh, 720px);\r\n  display:flex;\r\n  flex-direction:column;\r\n  gap:14px;\r\n}\r\n.tutorialHeader{\r\n  display:flex;\r\n  align-items:flex-start;\r\n  justify-content:space-between;\r\n  gap:12px;\r\n}\r\n.tutorialHeaderText{\r\n  display:flex;\r\n  flex-direction:column;\r\n  gap:4px;\r\n  min-width:0;\r\n}\r\n.tutorialTitle{\r\n  margin:0;\r\n  font-size:22px;\r\n  font-weight:800;\r\n}\r\n.tutorialStepLabel{\r\n  font-size:13px;\r\n  font-weight:700;\r\n  color:#a8c4ff;\r\n  opacity:.95;\r\n}\r\n.tutorialCloseX{\r\n  border:none;\r\n  background:transparent;\r\n  color:#fff;\r\n  font-size:28px;\r\n  line-height:1;\r\n  cursor:pointer;\r\n  opacity:.75;\r\n  padding:0 4px;\r\n  flex-shrink:0;\r\n}\r\n.tutorialCloseX:hover{ opacity:1; }\r\n.tutorialBody{\r\n  overflow-y:auto;\r\n  display:flex;\r\n  flex-direction:column;\r\n  gap:10px;\r\n  padding-right:4px;\r\n  min-height:140px;\r\n}\r\n.tutorialStepTitle{\r\n  margin:0;\r\n  font-size:16px;\r\n  font-weight:800;\r\n  color:#a8c4ff;\r\n}\r\n.tutorialStepBody{\r\n  margin:0;\r\n  font-size:14px;\r\n  line-height:1.5;\r\n  color:#d7def2;\r\n  opacity:.95;\r\n}\r\n.tutorialActions{\r\n  display:flex;\r\n  justify-content:space-between;\r\n  align-items:center;\r\n  gap:10px;\r\n  flex-wrap:wrap;\r\n}\r\n.tutorialBtnPrimary{\r\n  min-width:140px;\r\n  height:44px;\r\n  padding:0 16px;\r\n  border:none;\r\n  border-radius:10px;\r\n  cursor:pointer;\r\n  font-weight:800;\r\n  background:#4f46e5;\r\n  color:#fff;\r\n  box-shadow:0 8px 22px rgba(79,70,229,.35);\r\n  margin-left:auto;\r\n}\r\n.tutorialBtnPrimary:hover{ filter:brightness(1.05); }\r\n.tutorialBtnSecondary{\r\n  min-width:120px;\r\n  height:44px;\r\n  padding:0 16px;\r\n  border-radius:10px;\r\n  cursor:pointer;\r\n  font-weight:800;\r\n  background:transparent;\r\n  color:#e8edf8;\r\n  border:1px solid rgba(255,255,255,.22);\r\n}\r\n.tutorialBtnSecondary:hover{ background:rgba(255,255,255,.06); }\r\n.tutorialBtnSecondary:disabled{\r\n  opacity:.4;\r\n  cursor:not-allowed;\r\n}\r\n.tutorialBtnSecondary:disabled:hover{ background:transparent; }\r\n.tutorialBtnGhost{\r\n  min-width:110px;\r\n  height:44px;\r\n  padding:0 14px;\r\n  border-radius:10px;\r\n  cursor:pointer;\r\n  font-weight:800;\r\n  background:rgba(168,196,255,.12);\r\n  color:#d7e4ff;\r\n  border:1px solid rgba(168,196,255,.35);\r\n}\r\n.tutorialBtnGhost:hover{ background:rgba(168,196,255,.2); }\r\n.tutorialGlossaryItem{\r\n  padding:8px 0;\r\n  border-top:1px solid rgba(255,255,255,.08);\r\n}\r\n.tutorialGlossaryItem:first-of-type{ border-top:none; padding-top:0; }\r\n.tutorialGlossaryTitle{\r\n  margin:0 0 4px;\r\n  font-size:14px;\r\n  font-weight:800;\r\n  color:#a8c4ff;\r\n}\r\n.tutorialGlossaryBody{\r\n  margin:0;\r\n  font-size:13px;\r\n  line-height:1.45;\r\n  color:#d7def2;\r\n  opacity:.95;\r\n}\r\n\r\n.startFooter{\r\n  position:relative; z-index:1; display:flex; align-items:flex-end; justify-content:space-between;\r\n  gap:16px; padding:12px 20px 18px; min-height:72px;\r\n}\r\n.startLinks{ font-size:18px; line-height:1.25; text-shadow:0 2px 10px rgba(0,0,0,.55); }\r\n.startBrand{ display:flex; align-items:center; justify-content:flex-end; }\r\n.startBrandLogo{\r\n  height:132px; width:auto; filter: drop-shadow(0 8px 18px rgba(0,0,0,.5));\r\n}\r\n\r\n/* responsivo */\r\n@media (max-width: 860px){\r\n  .startBrandLogo{ height:34px; }\r\n  .startLinks{ font-size:16px; }\r\n  .startHint{ font-size:14px; }\r\n  .startSummary p{ font-size:13px; }\r\n}\r\n@media (max-width: 560px){\r\n  .startLinks{ font-size:14px; word-break:break-word; min-width:0; }\r\n  /* rodapé: permite quebra de linha para logo e URL não disputarem a mesma linha */\r\n  .startFooter{ flex-wrap:wrap; align-items:center; row-gap:8px; }\r\n  .startBrandLogo{ height:56px; }\r\n  .startCenter{ align-items:flex-start; overflow-y:auto; }\r\n  .tutorialModal{ padding:16px; max-height:min(86vh, 720px); }\r\n  .tutorialActions{ justify-content:stretch; }\r\n  .tutorialBtnPrimary,\r\n  .tutorialBtnSecondary,\r\n  .tutorialBtnGhost{ flex:1; min-width:0; margin-left:0; }\r\n}\r\n\r\n/* ====== START SCREEN ====== */\r\n.startScreen{\r\n  position:fixed; inset:0; overflow:hidden; background:#000;\r\n  display:flex; align-items:center; justify-content:center;\r\n  font-family: Inter, ui-sans-serif, system-ui;\r\n}\r\n.start-bg{\r\n  position:absolute; inset:0; width:100%; height:100%;\r\n  object-fit:cover; opacity:.85; filter:saturate(1.05);\r\n}\r\n\r\n/* logo “Sales GAME” no topo */\r\n.start-salesLogo{\r\n  position:absolute; top:28px; left:50%;\r\n  transform:translateX(-50%);\r\n  height:min(14vh, 120px);\r\n  object-fit:contain;\r\n}\r\n\r\n/* bloco da pessoa à direita */\r\n.personBox{\r\n  position:absolute; right:4.5%; bottom:0;\r\n  height:min(78vh, 640px);\r\n  aspect-ratio: 446 / 559;        /* aproxima a proporção do recorte */\r\n}\r\n.personImg{\r\n  width:100%; height:100%; object-fit:contain; display:block;\r\n  filter:drop-shadow(0 20px 40px rgba(0,0,0,.45));\r\n}\r\n\r\n/* ✅ logo no peito: posicionado relativamente à caixa da pessoa */\r\n.brandChest{\r\n  position:absolute;\r\n  left:50%;\r\n  top:58%;                        /* ajuste fino vertical do “peito” */\r\n  width:38%;                      /* tamanho do logo sobre a camiseta */\r\n  transform:translate(-50%,-50%);\r\n  pointer-events:none;\r\n  filter:drop-shadow(0 4px 10px rgba(0,0,0,.35));\r\n}\r\n\r\n/* formulário central */\r\n.start-form{\r\n  display:flex; flex-direction:column; gap:10px;\r\n  position:absolute; left:50%; top:54%;\r\n  transform:translate(-50%,-50%);\r\n  width:min(520px, 74vw);\r\n  align-items:center;\r\n}\r\n.start-input{\r\n  width:100%; padding:14px 16px; font-size:18px;\r\n  border-radius:10px; border:1px solid rgba(255,255,255,.25);\r\n  background:rgba(0,0,0,.35); color:#fff; outline:none;\r\n  backdrop-filter: blur(6px);\r\n}\r\n.start-input::placeholder{ color:#d9d9d9; }\r\n.start-btn{\r\n  padding:14px 22px; border:0; border-radius:12px; font-weight:800;\r\n  background:#4946ff; color:#fff; cursor:pointer;\r\n  box-shadow:0 10px 24px rgba(73,70,255,.25);\r\n}\r\n.start-btn:hover{ filter:brightness(1.05); }\r\n\r\n/* rodapé */\r\n.start-footer{\r\n  position:absolute; left:24px; bottom:20px; color:#fff;\r\n  text-shadow:0 1px 2px rgba(0,0,0,.6);\r\n  line-height:1.25; font-weight:700;\r\n}\r\n\r\n/* responsividade: em telas menores, sobe/ajusta logo do peito */\r\n@media (max-width: 980px){\r\n  .personBox{ right:2%; height:min(60vh, 520px); }\r\n  .brandChest{ top:57%; width:42%; }\r\n  .start-form{ top:50%; width:min(440px, 86vw); }\r\n}\r\n@media (max-width: 640px){\r\n  .personBox{ opacity:.85; height:min(50vh, 440px); }\r\n  .brandChest{ top:56%; width:44%; }\r\n  .start-salesLogo{ height:min(12vh, 90px); }\r\n}\r\n\r\n/* Lobby */\r\n.lobbyPage{ padding:24px; max-width:1100px; margin:0 auto; color:#eee; }\r\n.lobbyHeader{ display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:18px; }\r\n.lobbyHeader h1{ margin:0; }\r\n.meBox{ display:flex; align-items:center; gap:8px; }\r\n.meBox .txt{ padding:8px 10px; border-radius:8px; border:1px solid #2a2a2a; background:#161616; color:#fff; }\r\n.meBox .uid{ opacity:.6; font-size:12px; }\r\n.lobbyCreate{ display:flex; gap:10px; margin:14px 0 18px; }\r\n.lobbyCreate .txt,.lobbyCreate .num{ padding:10px 12px; border-radius:10px; border:1px solid #2a2a2a; background:#161616; color:#fff; width:260px; }\r\n.lobbyTable .head, .lobbyTable .row{ display:grid; grid-template-columns: 1fr 100px 220px; gap:12px; align-items:center; }\r\n.lobbyTable .head{ opacity:.7; padding:6px 0; border-bottom:1px dashed #2a2a2a; margin-bottom:6px; }\r\n.lobbyTable .row{ padding:8px 0; border-bottom:1px dashed #2a2a2a; }\r\n.lobbyTable .actions{ text-align:right; }\r\n.lobbyTable .empty{ opacity:.6; padding:20px 0; }\r\n\r\n.roomPage{ padding:24px; max-width:900px; margin:0 auto; color:#eee; }\r\n.roomHeader h2{ margin:0; }\r\n.roomHeader .sub{ opacity:.7; margin-bottom:14px; }\r\n.roomPlayers{ display:grid; grid-template-columns: repeat(auto-fill,minmax(220px,1fr)); gap:12px; margin-bottom:16px; }\r\n.pCard{ background:#171717; border:1px solid #2a2a2a; border-radius:10px; padding:12px; }\r\n.pCard.ready{ outline:2px solid #4f46e5; }\r\n.pName{ font-weight:800; }\r\n.pState{ opacity:.8; margin:4px 0 8px; }\r\n.btn.sm{ padding:8px 10px; font-size:14px; }\r\n.roomActions{ display:flex; gap:10px; }\r\n\r\n\r\n/* sidebar rola independente do resto */\r\n.side {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n  /* ajuste a largura se quiser */\r\n  max-height: calc(100vh - 88px); /* topbar + margem; ajuste se sua topbar for maior */\r\n  overflow-y: auto;\r\n  padding-right: 6px; /* pra não esconder a barra de rolagem */\r\n}\r\n\r\n/* bloco de controles fixo no rodapé da sidebar */\r\n.controlsSticky {\r\n  position: sticky;\r\n  bottom: 0;\r\n  z-index: 5;\r\n  background: rgba(15, 20, 32, 0.92);\r\n  backdrop-filter: blur(2px);\r\n  padding: 10px 8px 8px;\r\n  border-top: 1px solid rgba(255,255,255,.08);\r\n  /* opcional: sombra suave pra destacar */\r\n  box-shadow: 0 -6px 12px rgba(0,0,0,.25);\r\n}\r\n\r\n/* ====== Última rolagem do dado (somente apresentação) ====== */\r\n.diceResult{\r\n  box-sizing: border-box;\r\n  width: 100%;\r\n  margin: 0 0 10px;\r\n  padding: 12px 12px 10px;\r\n  border-radius: 12px;\r\n  border: 1px solid rgba(255,255,255,.10);\r\n  border-left: 3px solid rgba(109,93,252,.55);\r\n  background: #151824;\r\n}\r\n.diceResultHeader{\r\n  margin-bottom: 8px;\r\n}\r\n.diceResultLabel{\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: .06em;\r\n  text-transform: uppercase;\r\n  color: #8b93a7;\r\n}\r\n.diceResultContent{\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  min-width: 0;\r\n}\r\n.diceResultDie{\r\n  flex: none;\r\n  position: relative;\r\n  width: 64px;\r\n  height: 64px;\r\n  border-radius: 12px;\r\n  background: #f4f6fb;\r\n  border: 1px solid rgba(15,20,32,.18);\r\n  box-shadow: 0 4px 10px rgba(0,0,0,.22);\r\n}\r\n.diceResultDie--rolling{\r\n  background: linear-gradient(145deg, #eceff7, #f8fafc);\r\n  animation: diceResultSpin .55s ease-in-out infinite;\r\n}\r\n.diceResultPip{\r\n  position: absolute;\r\n  width: 10px;\r\n  height: 10px;\r\n  border-radius: 50%;\r\n  background: #1a1f2e;\r\n  transform: translate(-50%, -50%);\r\n}\r\n.diceResultPip--tl{ top: 22%; left: 22%; }\r\n.diceResultPip--tr{ top: 22%; left: 78%; }\r\n.diceResultPip--ml{ top: 50%; left: 22%; }\r\n.diceResultPip--mr{ top: 50%; left: 78%; }\r\n.diceResultPip--bl{ top: 78%; left: 22%; }\r\n.diceResultPip--br{ top: 78%; left: 78%; }\r\n.diceResultPip--c{  top: 50%; left: 50%; }\r\n.diceResultText{\r\n  min-width: 0;\r\n  flex: 1;\r\n}\r\n.diceResultPlayer{\r\n  margin: 0;\r\n  font-size: 15px;\r\n  font-weight: 800;\r\n  line-height: 1.3;\r\n  color: #f8fafc;\r\n  overflow-wrap: anywhere;\r\n}\r\n.diceResultHelp{\r\n  margin: 4px 0 0;\r\n  font-size: 12px;\r\n  line-height: 1.35;\r\n  color: #aab3c5;\r\n}\r\n@keyframes diceResultSpin{\r\n  0%{ transform: rotate(0deg) scale(1); }\r\n  40%{ transform: rotate(12deg) scale(1.06); }\r\n  70%{ transform: rotate(-10deg) scale(.98); }\r\n  100%{ transform: rotate(0deg) scale(1); }\r\n}\r\n@media (prefers-reduced-motion: reduce){\r\n  .diceResultDie--rolling{ animation: none; }\r\n}\r\n@media (max-width: 760px){\r\n  .diceResult{ padding: 10px; }\r\n  .diceResultDie{\r\n    width: 56px;\r\n    height: 56px;\r\n  }\r\n  .diceResultPip{ width: 8px; height: 8px; }\r\n  .diceResultPlayer{ font-size: 14px; }\r\n}\r\n\r\n/* se seu .content não for flex, garanta isso */\r\n.content {\r\n  display: flex;\r\n  gap: 12px;\r\n}\r\n\r\n/* garante que o tabuleiro ocupe o espaço restante */\r\n.boardWrap {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n}\r\n\r\n/* ---- Purchase impact preview (piloto clientes) ---- */\r\n.purchasePreviewHint {\r\n  margin: 0 0 12px;\r\n  font-size: 14px;\r\n  line-height: 1.45;\r\n  color: #d7def2;\r\n  opacity: 0.95;\r\n}\r\n.purchasePreview {\r\n  margin: 0 0 12px;\r\n  padding: 12px;\r\n  border-radius: 10px;\r\n  border: 1px solid rgba(255,255,255,.14);\r\n  background: rgba(0,0,0,.22);\r\n}\r\n.purchasePreviewTitle {\r\n  font-weight: 800;\r\n  margin-bottom: 10px;\r\n  font-size: 15px;\r\n}\r\n.purchasePreviewGrid {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n.purchasePreviewRow {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  flex-wrap: wrap;\r\n  font-size: 13px;\r\n  line-height: 1.4;\r\n}\r\n.purchasePreviewRowStrong {\r\n  font-weight: 800;\r\n  padding-top: 4px;\r\n  border-top: 1px dashed rgba(255,255,255,.16);\r\n}\r\n.purchasePreviewRow small {\r\n  font-weight: 700;\r\n  opacity: 0.95;\r\n}\r\n.purchasePreviewDeltaPositive { color: #7dffa3; }\r\n.purchasePreviewDeltaNegative { color: #ff9b9b; }\r\n.purchasePreviewDeltaNeutral { color: #d7def2; }\r\n\r\n.purchasePreviewExtra {\r\n  margin: 0 0 12px;\r\n  padding: 12px;\r\n  border-radius: 10px;\r\n  border: 1px solid rgba(255,255,255,.14);\r\n  background: rgba(0,0,0,.18);\r\n}\r\n.purchasePreviewExtraTitle {\r\n  font-weight: 800;\r\n  margin-bottom: 10px;\r\n  font-size: 15px;\r\n}\r\n.purchasePreviewAlert {\r\n  margin-top: 10px;\r\n  padding: 8px 10px;\r\n  border-radius: 8px;\r\n  border: 1px solid rgba(255, 180, 80, .35);\r\n  background: rgba(255, 160, 40, .12);\r\n  color: #ffd9a8;\r\n  font-size: 13px;\r\n  line-height: 1.4;\r\n  font-weight: 700;\r\n}\r\n\r\n.trainingAppliedLine {\r\n  font-size: 12px;\r\n  line-height: 1.35;\r\n  font-weight: 700;\r\n  opacity: 0.95;\r\n  margin: 0 0 10px;\r\n  color: #e9ecf1;\r\n}\r\n\r\n/* ====== Modal de treinamentos: grades responsivas ====== */\r\n\r\n/* auto-fit reproduz repeat(n, 1fr) no desktop (1–4 tipos) e quebra no mobile */\r\n.trainingVendorRow{\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\r\n  gap: 10px;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n/* mesmos valores do layout inline anterior no desktop */\r\n.trainingProducts{\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0,1fr));\r\n  gap: 12px;\r\n  margin: 4px 0 10px;\r\n}\r\n\r\n.trainingActionsRow{\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  margin: 6px 0 6px;\r\n}\r\n\r\n@media (max-width: 760px){\r\n  /* duas colunas quando ainda há espaço (561–760px) */\r\n  .trainingProducts{ grid-template-columns: repeat(2, minmax(0,1fr)); }\r\n}\r\n\r\n@media (max-width: 560px){\r\n  /* uma coluna: cards em largura total, texto quebra normalmente */\r\n  .trainingProducts{ grid-template-columns: 1fr; }\r\n  .trainingActionsRow{ flex-wrap: wrap; row-gap: 8px; }\r\n}\r\n\r\n/* ====== Modal \"Direto de Compra\": overlay, card e grade responsivos ====== */\r\n\r\n/* overlay: centraliza e garante respiro de 12px em volta do card */\r\n.directBuyWrap{\r\n  position: fixed;\r\n  inset: 0;\r\n  background: rgba(0,0,0,.55);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  z-index: 1000;\r\n  padding: 12px;\r\n  box-sizing: border-box;\r\n  overflow-y: auto;\r\n  overflow-x: hidden;\r\n}\r\n\r\n/* box-sizing: border-box garante que padding + borda fiquem DENTRO\r\n   da largura calculada (sem ele, o card estourava a viewport) */\r\n.directBuyCard{\r\n  box-sizing: border-box;\r\n  width: min(1000px, calc(100vw - 24px));\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  max-height: 92vh;\r\n  max-height: 92dvh;\r\n  overflow-y: auto;\r\n  overflow-x: hidden;\r\n  background: #1b1f2a;\r\n  color: #e9ecf1;\r\n  border-radius: 16px;\r\n  padding: 20px;\r\n  box-shadow: 0 10px 40px rgba(0,0,0,.4);\r\n  border: 1px solid rgba(255,255,255,.12);\r\n  position: relative;\r\n}\r\n\r\n.directBuyTitle{\r\n  margin: 6px 0 8px;\r\n  font-weight: 800;\r\n  min-width: 0;\r\n  overflow-wrap: break-word;\r\n}\r\n\r\n.directBuyContext{\r\n  margin: 0 0 12px;\r\n  font-size: 13px;\r\n  line-height: 1.45;\r\n  color: rgba(233,236,241,.85);\r\n  max-width: 52rem;\r\n}\r\n\r\n.directBuyGrid{\r\n  display: grid;\r\n  grid-template-columns: repeat(4, minmax(180px, 1fr));\r\n  gap: 12px;\r\n  width: 100%;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  box-sizing: border-box;\r\n}\r\n.directBuyGrid > *{\r\n  width: 100%;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  box-sizing: border-box;\r\n  overflow-wrap: break-word;\r\n}\r\n\r\n.directBuyBtn{\r\n  box-sizing: border-box;\r\n  margin-top: auto;\r\n  align-self: center;\r\n  min-width: 140px;\r\n  max-width: 100%;\r\n  padding: 10px 14px;\r\n  border-radius: 10px;\r\n  border: none;\r\n  font-weight: 900;\r\n  cursor: pointer;\r\n}\r\n\r\n@media (max-width: 760px){\r\n  /* colunas explícitas: minmax(0,1fr) impede que conteúd