ocus .boardWrap--follow{\r\n    grid-column: 1;\r\n    grid-row: 2;\r\n    position: static;\r\n    width: 100%;\r\n    max-width: 100%;\r\n    justify-content: center;\r\n  }\r\n  .content--boardFocus .side{\r\n    display: none;\r\n  }\r\n  .content--boardFocus .board,\r\n  .content--boardFocus .boardWrap--follow .board{\r\n    --sg-board-max-h: calc(100dvh - 96px - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px));\r\n    width: min(100%, calc(var(--sg-board-max-h) * 800 / 700));\r\n    max-width: 100%;\r\n    max-height: var(--sg-board-max-h);\r\n  }\r\n\r\n  /* peões: tamanho visual já existente no landscape */\r\n  .token{\r\n    transform-origin: 0 0;\r\n    scale: 0.95;\r\n  }\r\n  .token.token--active{\r\n    scale: 0.82;\r\n  }\r\n}\r\n\r\n/* ====== Guard temporário: mobile landscape → pedir portrait ======\r\n   Overlay só em touch/coarse + landscape estreito. Jogo permanece montado.\r\n   Mensagem ancorada no canto superior esquerdo com px fixos — legível\r\n   mesmo com zoom/viewport estranho do Safari ao girar. */\r\n.mobilePortraitGuard{\r\n  display: none;\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 2147483000;\r\n  box-sizing: border-box;\r\n  overflow: hidden;\r\n  -webkit-text-size-adjust: 100%;\r\n  text-size-adjust: 100%;\r\n  padding-top: calc(16px + env(safe-area-inset-top, 0px));\r\n  padding-right: calc(16px + env(safe-area-inset-right, 0px));\r\n  padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));\r\n  padding-left: calc(16px + env(safe-area-inset-left, 0px));\r\n  align-items: flex-start;\r\n  justify-content: flex-start;\r\n  background: rgba(8, 10, 16, 0.96);\r\n  color: #e8ecf4;\r\n  text-align: left;\r\n  pointer-events: auto;\r\n  touch-action: none;\r\n  -webkit-user-select: none;\r\n  user-select: none;\r\n}\r\n.mobilePortraitGuardInner{\r\n  box-sizing: border-box;\r\n  width: min(320px, calc(100% - 32px));\r\n  max-width: 320px;\r\n  margin: 0;\r\n  padding: 16px;\r\n  border-radius: 10px;\r\n  b