a real da partida ===== */\n@media (min-width: 961px){\n  .content{\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) clamp(260px, 20vw, 320px);\n    align-items: stretch;\n    gap: var(--gap);\n    min-width: 0;\n  }\n\n  .boardWrap{\n    width: 100%;\n    min-width: 0;\n    min-height: 0;\n    overflow: hidden;\n    container-type: size;\n  }\n\n  .boardWrap .sg40GameBoard{\n    width: 100%;\n    height: auto;\n    max-width: 100%;\n    max-height: 100%;\n    aspect-ratio: 4 / 3;\n  }\n\n  @supports (width: 1cqw){\n    .boardWrap .sg40GameBoard{\n      width: min(100cqw, 133.333cqh);\n    }\n  }\n\n  .side{\n    width: 100%;\n    min-width: 0;\n    max-width: 320px;\n    height: 100%;\n    max-height: 100%;\n    overflow-x: hidden;\n    overflow-y: auto;\n    scrollbar-gutter: stable;\n  }\n}\n\n@media (max-width: 960px){\n  .boardWrap .sg40GameBoard,\n  .content--boardFocus .boardWrap .sg40GameBoard{\n    width: 100%;\n    height: auto;\n    max-width: 100%;\n    max-height: none;\n    aspect-ratio: 4 / 3;\n  }\n}\n\n/* ===== P0: shell responsivo da partida =====\n   Este bloco é deliberadamente final: consolida as regras históricas acima\n   sem alterar componentes, callbacks ou o motor do jogo. */\nhtml,\nbody,\n#root {\n  width: 100%;\n  max-width: 100%;\n  height: 100%;\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n}\n\n.page {\n  --game-header-height: 60px;\n  box-sizing: border-box;\n  width: 100%;\n  max-width: 100%;\n  height: 100dvh;\n  min-width: 0;\n  min-height: 0;\n  display: grid;\n  grid-template-rows: var(--game-header-height) minmax(0, 1fr);\n  overflow: hidden;\n}\n\n.page > .topbar {\n  box-sizing: border-box;\n  width: 100%;\n  max-width: 100%;\n  height: var(--game-header-height);\n  min-width: 0;\n  min-height: var(--game-header-height);\n  max-height: var(--game-header-height);\n  grid-row: 1;\n  overflow: hidden;\n}\n\n.topbarPrimary,\n.topbarSecondary,\n.topbarRow,\n.content,\n.boardWrap,\n.side,\n.side > .hud,\n.c